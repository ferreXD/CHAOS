+    [Fact]
+    public async Task Post_returns_a_task_serialized_with_version_1()
+    {
+        // C-001 (serialized field name) + C-003 (created tasks start at version 1).
+        var client = _factory.CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Version me", status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        Assert.True(json.RootElement.TryGetProperty("version", out var version));
+        Assert.Equal(1, version.GetInt32());
+    }
+
+    [Fact]
+    public async Task Seeded_tasks_start_at_version_1()
