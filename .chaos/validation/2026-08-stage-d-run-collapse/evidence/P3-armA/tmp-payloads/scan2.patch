+        var client = _factory.CreateClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Unconditional", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(1, created!.Version);
+
+        var first = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Pass one", status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.OK, first.StatusCode);
+        Assert.Equal(2, (await first.Content.ReadFromJsonAsync<TaskDto>())!.Version);
+
+        var second = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Pass two", status = "Done", priority = "High" });
+        Assert.Equal(HttpStatusCode.OK, second.StatusCode);
+        Assert.Equal(3, (await second.Content.ReadFromJsonAsync<TaskDto>())!.Version);
+    }
