diff --git a/src/TaskTracker.Api/Security/ApiKeyEndpointFilter.cs b/src/TaskTracker.Api/Security/ApiKeyEndpointFilter.cs
new file mode 100644
index 0000000..5ae78c5
--- /dev/null
+++ b/src/TaskTracker.Api/Security/ApiKeyEndpointFilter.cs
@@ -0,0 +1,44 @@
+namespace TaskTracker.Api.Security;
+
+/// <summary>
+/// Endpoint filter that requires a valid API key in the <c>X-Api-Key</c> request header.
+/// </summary>
+/// <remarks>
+/// Enforcement deliberately lives in the HTTP layer: it is attached to the <c>/tasks</c> route
+/// group, so the domain (<c>Domain/**</c>) gains no dependency on ASP.NET types (R-004). Because
+/// an endpoint filter runs <em>before</em> the route handler, an unauthenticated request never
+/// reaches the store — it can neither read nor mutate a task, and it never sees a 404/400 that
+/// would leak whether a task exists. The public root health endpoint <c>GET /</c> is mapped
+/// outside this group and therefore stays open.
+/// <para>
+/// The posture crossing this represents (the API was documented as deliberately open) is
+/// recorded in <c>.chaos/changes/require-api-key-auth/adr/ADR-001-*.md</c>.
+/// </para>
+/// </remarks>
+public sealed class ApiKeyEndpointFilter : IEndpointFilter
+{
+    /// <summary>Request header the API key must be presented in.</summary>
+    public const string HeaderName = "X-Api-Key";
+
+    /// <summary>Configuration key holding the valid API key.</summary>
+    public const string ConfigurationKey = "ApiKey";
+
+    /// <summary>Key used when <see cref="ConfigurationKey"/> is not configured.</summary>
+    public const string DefaultApiKey = "test-secret-key";
+
+    private readonly string _expectedKey;
+
+    public ApiKeyEndpointFilter(IConfiguration configuration)
+        => _expectedKey = configuration[ConfigurationKey] ?? DefaultApiKey;
+
+    public ValueTask<object?> InvokeAsync(
+        EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        var presented = context.HttpContext.Request.Headers[HeaderName].ToString();
+
+        if (!string.Equals(presented, _expectedKey, StringComparison.Ordinal))
+            return ValueTask.FromResult<object?>(Results.Unauthorized());
+
+        return next(context);
+    }
+}
