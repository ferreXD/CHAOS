diff --git a/src/TaskTracker.Api/Endpoints/TaskEndpoints.cs b/src/TaskTracker.Api/Endpoints/TaskEndpoints.cs
index 612f44c..1a2b835 100644
--- a/src/TaskTracker.Api/Endpoints/TaskEndpoints.cs
+++ b/src/TaskTracker.Api/Endpoints/TaskEndpoints.cs
@@ -17,8 +17,20 @@ public static class TaskEndpoints
     {
         var group = app.MapGroup("/tasks");
 
-        // GET /tasks — returns every task in the store. No filtering (yet).
-        group.MapGet("/", (TaskStore store) => Results.Ok(store.All()));
+        // GET /tasks — every task, or only those matching an optional ?status= filter.
+        group.MapGet("/", (string? status, TaskStore store) =>
+        {
+            if (string.IsNullOrWhiteSpace(status))
+                return Results.Ok(store.All());
+
+            if (!TryParseTaskState(status, out var state))
+                return Results.BadRequest(new
+                {
+                    error = $"Unknown status '{status}'. Valid values: {ValidTaskStates}."
+                });
+
+            return Results.Ok(store.All().Where(task => task.Status == state).ToList());
+        });
 
         // GET /tasks/{id}
         group.MapGet("/{id:guid}", (Guid id, TaskStore store) =>
@@ -51,4 +63,28 @@ public static class TaskEndpoints
 
         return app;
     }
+
+    /// <summary>The accepted <c>?status=</c> values, for the 400 message.</summary>
+    private static readonly string ValidTaskStates = string.Join(", ", Enum.GetNames<TaskState>());
+
+    /// <summary>
+    /// Resolves a <c>?status=</c> query value to a <see cref="TaskState"/> by NAME only,
+    /// case-insensitively. Names only is deliberate: <c>Enum.TryParse</c> would also accept
+    /// numeric text ("0", "7"), turning a typo into a silent — or nonsensical — filter, and the
+    /// contract says an unrecognised value is a 400.
+    /// </summary>
+    private static bool TryParseTaskState(string value, out TaskState state)
+    {
+        foreach (var candidate in Enum.GetValues<TaskState>())
+        {
+            if (string.Equals(candidate.ToString(), value, StringComparison.OrdinalIgnoreCase))
+            {
+                state = candidate;
+                return true;
+            }
+        }
+
+        state = default;
+        return false;
+    }
 }
diff --git a/tests/TaskTracker.Tests/TaskEndpointsTests.cs b/tests/TaskTracker.Tests/TaskEndpointsTests.cs
index d2870e9..bd53d28 100644
--- a/tests/TaskTracker.Tests/TaskEndpointsTests.cs
+++ b/tests/TaskTracker.Tests/TaskEndpointsTests.cs
@@ -90,6 +90,66 @@ public class TaskEndpointsTests : IClassFixture<WebApplicationFactory<Program>>
         Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
     }
 
+    [Theory]
+    [InlineData("Open", "Add query-param filters to GET /tasks")]
+    [InlineData("InProgress", "Review the CHAOS proposal")]
+    [InlineData("Done", "Write the project README")]
+    public async Task Get_tasks_with_status_returns_only_that_status(string status, string seededTitle)
+    {
+        var client = _factory.CreateClient();
+
+        var tasks = await client.GetFromJsonAsync<List<TaskDto>>($"/tasks?status={status}");
+
+        Assert.NotNull(tasks);
+        Assert.NotEmpty(tasks!);
+        Assert.All(tasks!, t => Assert.Equal(status, t.Status));
+        Assert.Contains(tasks!, t => t.Title == seededTitle);
+    }
+
+    [Theory]
+    [InlineData("open", "Open")]
+    [InlineData("inprogress", "InProgress")]
+    [InlineData("DONE", "Done")]
+    public async Task Get_tasks_status_filter_is_case_insensitive(string lowered, string canonical)
+    {
+        var client = _factory.CreateClient();
+
+        var loweredTasks = await client.GetFromJsonAsync<List<TaskDto>>($"/tasks?status={lowered}");
+        var canonicalTasks = await client.GetFromJsonAsync<List<TaskDto>>($"/tasks?status={canonical}");
+
+        Assert.NotEmpty(loweredTasks!);
+        Assert.Equal(canonicalTasks!.Select(t => t.Id), loweredTasks!.Select(t => t.Id));
+    }
+
+    [Fact]
+    public async Task Get_tasks_with_unknown_status_is_rejected()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/tasks?status=Bogus");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        var body = await response.Content.ReadAsStringAsync();
+        Assert.DoesNotContain("\"title\"", body, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Get_tasks_without_status_returns_every_task()
+    {
+        var client = _factory.CreateClient();
+
+        var all = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        var open = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=Open");
+        var inProgress = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=InProgress");
+        var done = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=Done");
+
+        // The unfiltered list is exactly the three filtered lists together — no task is hidden
+        // by, or invented for, the filter.
+        Assert.Equal(all!.Count, open!.Count + inProgress!.Count + done!.Count);
+        Assert.Equal(all.Select(t => t.Id).OrderBy(id => id),
+                     open.Concat(inProgress).Concat(done).Select(t => t.Id).OrderBy(id => id));
+    }
+
     /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
     private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
 }
