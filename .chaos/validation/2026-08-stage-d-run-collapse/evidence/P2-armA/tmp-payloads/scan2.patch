+    // --- soft delete (change: soft-delete-tasks) -------------------------------------------
+
+    [Fact]
+    public async Task Active_task_serializes_deleted_at_as_null()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Active task", status = "Open", priority = "Low" });
+        var json = await response.Content.ReadAsStringAsync();
+
+        // C-001: the field is named `deletedAt` and is null while the task is active.
+        Assert.Contains("\"deletedAt\":null", json);
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Null(created!.DeletedAt);
+    }
+
+    [Fact]
+    public async Task Delete_soft_deletes_and_retains_the_task()
+    {
+        var client = _factory.CreateClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Soft target", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var delete = await client.DeleteAsync($"/tasks/{created!.Id}");
+        Assert.Equal(HttpStatusCode.NoContent, delete.StatusCode);
+
+        // C-002: retained, with deletedAt stamped — visible only through the opt-in.
+        var all = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?includeDeleted=true");
+        var retained = Assert.Single(all!, t => t.Id == created.Id);
+        Assert.NotNull(retained.DeletedAt);
+    }
+
+    [Fact]
+    public async Task Delete_unknown_id_returns_404()
+    {
+        var client = _factory.CreateClient();
+
+        var delete = await client.DeleteAsync($"/tasks/{Guid.NewGuid()}");
+
+        Assert.Equal(HttpStatusCode.NotFound, delete.StatusCode);
+    }
+
+    [Fact]
+    public async Task Get_tasks_hides_soft_deleted_tasks_by_default()
+    {
+        var client = _factory.CreateClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Hidden after delete", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+        await client.DeleteAsync($"/tasks/{created!.Id}");
+
+        var active = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        var all = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?includeDeleted=true");
+
+        Assert.DoesNotContain(active!, t => t.Id == created.Id);   // C-004
+        Assert.Contains(all!, t => t.Id == created.Id);            // C-005
+        Assert.All(active!, t => Assert.Null(t.DeletedAt));
+    }
+
+    [Fact]
+    public async Task Get_by_id_returns_404_for_a_soft_deleted_task()
+    {
+        var client = _factory.CreateClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Gone by id", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+        await client.DeleteAsync($"/tasks/{created!.Id}");
+
+        var getAfter = await client.GetAsync($"/tasks/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.NotFound, getAfter.StatusCode);   // C-006
+    }
+
+    [Fact]
+    public async Task Id_addressed_writes_treat_a_soft_deleted_task_as_absent()
+    {
+        var client = _factory.CreateClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Absent", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+        await client.DeleteAsync($"/tasks/{created!.Id}");
+
+        // APPLY-DEC-001: a soft-deleted task is absent for every id-addressed verb.
