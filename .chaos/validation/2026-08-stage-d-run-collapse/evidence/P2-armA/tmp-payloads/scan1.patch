+    /// <summary>
+    /// Soft-deletes a task: stamps <see cref="TaskItem.DeletedAt"/> and RETAINS the row.
+    /// Returns the soft-deleted task, or <c>null</c> when no active task carries that id
+    /// (unknown id, or a task that was already soft-deleted — see APPLY-DEC-001).
+    /// There is deliberately no hard-delete path: retention is what the change buys.
+    /// </summary>
+    public TaskItem? SoftDelete(Guid id, DateTimeOffset deletedAt)
+    {
+        while (_tasks.TryGetValue(id, out var existing))
+        {
+            if (existing.DeletedAt is not null)
+                return null;
+
+            var deleted = existing with { DeletedAt = deletedAt };
+            if (_tasks.TryUpdate(id, deleted, existing))
+                return deleted;
+        }
+
+        return null;
+    }
 
