-    public bool Remove(Guid id) => _tasks.TryRemove(id, out _);
+    /// <summary>
+    /// Soft-deletes an active task: stamps <c>DeletedAt</c> with the current time and keeps the
+    /// row. Returns null when the id is unknown or the task is already soft-deleted — in which
+    /// case the existing <c>DeletedAt</c> is left untouched (RUN-DEC-002). Supersedes the former
+    /// hard <c>Remove</c>; nothing is evicted from the store any more.
+    /// </summary>
+    public TaskItem? SoftDelete(Guid id)
+    {
+        // Compare-and-swap, retried on a lost race: the task the stamp is written onto must be
+        // the same one whose DeletedAt was observed to be null. The hard Remove this supersedes
+        // was atomic (TryRemove), so anything less would make concurrent deletes report 204
+        // twice and overwrite the first stamp.
+        while (_tasks.TryGetValue(id, out var existing) && existing.DeletedAt is null)
+        {
+            var deleted = existing with { DeletedAt = DateTimeOffset.UtcNow };
+            if (_tasks.TryUpdate(id, deleted, existing))
+                return deleted;
+        }
+
+        return null;
+    }
 
