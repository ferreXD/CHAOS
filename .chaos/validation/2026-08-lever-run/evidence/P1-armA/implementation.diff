+namespace TaskTracker.Api.Auth;
+
+/// <summary>
+/// Endpoint metadata marking a route as requiring the API key. Presence of this marker —
+/// not the request path — is what makes an endpoint protected.
+/// </summary>
+public sealed class RequireApiKeyMetadata
+{
+    public static readonly RequireApiKeyMetadata Instance = new();
+}
+
+/// <summary>
+/// API-key authentication for the task endpoints: a request to a marked endpoint must present
+/// the configured key in the <c>X-Api-Key</c> header or it is rejected with 401.
+/// </summary>
+/// <remarks>
+/// <para>
+/// Protection is conferred by <see cref="RequireApiKeyMetadata"/> on the endpoint (applied once
+/// to the <c>/tasks</c> route group), so a route added to that group later inherits the check
+/// automatically and a route outside it — the public <c>GET /</c> health endpoint — can never be
+/// gated by accident. No request path is ever compared.
+/// </para>
+/// <para>
+/// The check runs as middleware registered after <c>UseRouting()</c>: endpoint selection has
+/// happened, so the marker is visible, but the endpoint's own delegate has not run, so the 401
+/// precedes model binding, existence checks and payload validation alike. An
+/// <c>IEndpointFilter</c> cannot do this — minimal-API parameter binding completes before the
+/// filter pipeline is invoked, so an absent request body would surface as 400 before the key was
+/// ever inspected. See
+/// <c>.chaos/changes/require-api-key-auth/adr/2026-08-03-api-key-authentication-on-task-endpoints.md</c>
+/// (Decision clause 1, amended by RUN-DEC-002).
+/// </para>
+/// <para>
+/// Scope: a single shared static key. No per-caller identity, no rotation, no revocation, and no
+/// authorization model.
+/// </para>
+/// </remarks>
+public static class ApiKeyAuthentication
+{
+    /// <summary>The request header carrying the key.</summary>
+    public const string HeaderName = "X-Api-Key";
+
+    /// <summary>The configuration key holding the expected value.</summary>
+    public const string ConfigurationKey = "ApiKey";
+
+    /// <summary>
+    /// Used when <see cref="ConfigurationKey"/> is not set. A demo default, not a secret —
+    /// it must be removed before this API is ever hosted for real.
+    /// </summary>
+    public const string DefaultApiKey = "test-secret-key";
+
+    /// <summary>Marks every endpoint built by <paramref name="builder"/> as requiring the API key.</summary>
+    public static TBuilder RequireApiKey<TBuilder>(this TBuilder builder)
+        where TBuilder : IEndpointConventionBuilder
+    {
+        builder.WithMetadata(RequireApiKeyMetadata.Instance);
+        return builder;
+    }
+
+    /// <summary>
+    /// Enforces the API key on endpoints marked with <see cref="RequireApiKeyMetadata"/>.
+    /// Must be registered after <c>UseRouting()</c> and before the endpoints run.
+    /// </summary>
+    public static IApplicationBuilder UseApiKeyAuthentication(this IApplicationBuilder app) =>
+        app.Use(async (context, next) =>
+        {
+            if (context.GetEndpoint()?.Metadata.GetMetadata<RequireApiKeyMetadata>() is null)
+            {
+                await next(context);
+                return;
+            }
+
+            var configuration = context.RequestServices.GetRequiredService<IConfiguration>();
+            var presented = context.Request.Headers[HeaderName].ToString();
+
+            if (!string.Equals(presented, ResolveExpectedKey(configuration), StringComparison.Ordinal))
+            {
+                context.Response.StatusCode = StatusCodes.Status401Unauthorized;
+                return;
+            }
+
+            await next(context);
+        });
+
+    /// <summary>
+    /// The key a request must present. An empty configured value falls back to the default rather
+    /// than becoming the expected key: a missing header reads as the empty string, so honouring ""
+    /// as valid would silently accept every unauthenticated request.
+    /// </summary>
+    private static string ResolveExpectedKey(IConfiguration configuration)
+    {
+        var configured = configuration[ConfigurationKey];
+        return string.IsNullOrEmpty(configured) ? DefaultApiKey : configured;
+    }
+}
