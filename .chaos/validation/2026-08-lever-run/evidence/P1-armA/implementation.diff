@@ -0,0 +1,265 @@
+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Integration tests for the API-key requirement on the <c>/tasks</c> routes: that every route
+/// is guarded, that the check precedes existence and validation checks, that a rejected request
+/// mutates nothing, that the health endpoint stays public, and that configuration overrides the
+/// built-in default.
+/// </summary>
+public class ApiKeyAuthenticationTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private const string ValidKey = "test-secret-key";
+    private const string WrongKey = "not-the-key";
+
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public ApiKeyAuthenticationTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    private HttpClient CreateAuthenticatedClient()
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Add("X-Api-Key", ValidKey);
+        return client;
+    }
+
+    /// <summary>Builds a request carrying an explicit key value, or none when <paramref name="key"/> is null.</summary>
+    private static HttpRequestMessage Request(HttpMethod method, string url, string? key)
+    {
+        var request = new HttpRequestMessage(method, url);
+        if (key is not null)
+            request.Headers.Add("X-Api-Key", key);
+        return request;
+    }
+
+    public static TheoryData<string, string> AllTaskRoutes => new()
+    {
+        { "GET", "/tasks" },
+        { "GET", "/tasks/11111111-1111-1111-1111-111111111111" },
+        { "POST", "/tasks" },
+        { "PUT", "/tasks/11111111-1111-1111-1111-111111111111" },
+        { "DELETE", "/tasks/11111111-1111-1111-1111-111111111111" },
+    };
+
+    // C-001, C-002 — every /tasks route rejects a request with no key.
+    [Theory]
+    [MemberData(nameof(AllTaskRoutes))]
+    public async Task Every_task_route_rejects_a_missing_key(string method, string url)
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.SendAsync(Request(new HttpMethod(method), url, key: null));
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    // C-001, C-003 — every /tasks route rejects a request with the wrong key.
+    [Theory]
+    [MemberData(nameof(AllTaskRoutes))]
+    public async Task Every_task_route_rejects_an_incorrect_key(string method, string url)
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.SendAsync(Request(new HttpMethod(method), url, WrongKey));
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    // C-002 — a rejected list request returns no task data.
+    [Fact]
+    public async Task Rejected_list_request_returns_no_task_data()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/tasks");
+        var body = await response.Content.ReadAsStringAsync();
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+        Assert.DoesNotContain("Add query-param filters", body);
+    }
+
+    // C-004, C-005 — the default key is accepted when configuration key `ApiKey` is not set.
+    [Fact]
+    public async Task Default_key_is_accepted_when_configuration_is_not_set()
+    {
+        var client = CreateAuthenticatedClient();
+
+        var response = await client.GetAsync("/tasks");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    // C-004 — a configured `ApiKey` becomes the only valid key; the default stops working.
+    [Fact]
+    public async Task Configured_key_overrides_the_default()
+    {
+        const string configuredKey = "configured-key-9f2c";
+
+        using var factory = _factory.WithWebHostBuilder(
+            builder => builder.UseSetting("ApiKey", configuredKey));
+
+        var withConfigured = factory.CreateClient();
+        var accepted = await withConfigured.SendAsync(Request(HttpMethod.Get, "/tasks", configuredKey));
+        Assert.Equal(HttpStatusCode.OK, accepted.StatusCode);
+
+        var withDefault = factory.CreateClient();
+        var rejected = await withDefault.SendAsync(Request(HttpMethod.Get, "/tasks", ValidKey));
+        Assert.Equal(HttpStatusCode.Unauthorized, rejected.StatusCode);
+    }
+
+    // C-005 — an empty configured key falls back to the default instead of becoming the expected
+    // value. Without this, a missing header (which reads as "") would match and authenticate every
+    // anonymous request.
+    [Fact]
+    public async Task Empty_configured_key_falls_back_to_the_default()
+    {
+        using var factory = _factory.WithWebHostBuilder(
+            builder => builder.UseSetting("ApiKey", string.Empty));
+
+        var anonymous = await factory.CreateClient().GetAsync("/tasks");
+        Assert.Equal(HttpStatusCode.Unauthorized, anonymous.StatusCode);
+
+        var withDefault = await factory.CreateClient()
+            .SendAsync(Request(HttpMethod.Get, "/tasks", ValidKey));
+        Assert.Equal(HttpStatusCode.OK, withDefault.StatusCode);
+    }
+
+    // C-006 — authentication precedes the existence check: 401, not 404.
+    [Fact]
+    public async Task Unauthenticated_request_for_a_missing_task_returns_401_not_404()
+    {
+        var client = _factory.CreateClient();
+        var absentId = Guid.NewGuid();
+
+        var response = await client.GetAsync($"/tasks/{absentId}");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+
+        // The same request with a valid key proves the id really is absent, so the 401 above
+        // genuinely pre-empted a 404 rather than masking an existing task.
+        var authenticated = await CreateAuthenticatedClient().GetAsync($"/tasks/{absentId}");
+        Assert.Equal(HttpStatusCode.NotFound, authenticated.StatusCode);
+    }
+
+    // C-007 — authentication precedes payload validation: 401, not 400.
+    [Fact]
+    public async Task Unauthenticated_post_with_a_blank_title_returns_401_not_400()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title = "", status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    // C-007 — the same ordering holds on update.
+    [Fact]
+    public async Task Unauthenticated_put_with_a_blank_title_returns_401_not_400()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.PutAsJsonAsync(
+            $"/tasks/{Guid.NewGuid()}", new { title = "", status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    // C-008 — a rejected create mutates nothing.
+    [Fact]
+    public async Task Unauthenticated_post_creates_no_task()
+    {
+        var title = $"should-never-exist-{Guid.NewGuid()}";
+        var anonymous = _factory.CreateClient();
+
+        var response = await anonymous.PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+
+        var tasks = await CreateAuthenticatedClient().GetFromJsonAsync<List<TaskDto>>("/tasks");
+        Assert.DoesNotContain(tasks!, t => t.Title == title);
+    }
+
+    // C-008 — a rejected delete mutates nothing: the task survives.
+    [Fact]
+    public async Task Unauthenticated_delete_does_not_remove_the_task()
+    {
+        var authenticated = CreateAuthenticatedClient();
+        var created = await (await authenticated.PostAsJsonAsync(
+                "/tasks", new { title = "Survives an unauthenticated delete", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var anonymous = _factory.CreateClient();
+        var delete = await anonymous.DeleteAsync($"/tasks/{created!.Id}");
+        Assert.Equal(HttpStatusCode.Unauthorized, delete.StatusCode);
+
+        var stillThere = await authenticated.GetAsync($"/tasks/{created.Id}");
+        Assert.Equal(HttpStatusCode.OK, stillThere.StatusCode);
+    }
+
+    // C-008 — a rejected update mutates nothing: the title is unchanged.
+    [Fact]
+    public async Task Unauthenticated_put_does_not_update_the_task()
+    {
+        var authenticated = CreateAuthenticatedClient();
+        var created = await (await authenticated.PostAsJsonAsync(
+                "/tasks", new { title = "Original title", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var anonymous = _factory.CreateClient();
+        var update = await anonymous.PutAsJsonAsync(
+            $"/tasks/{created!.Id}", new { title = "Hijacked title", status = "Done", priority = "High" });
+        Assert.Equal(HttpStatusCode.Unauthorized, update.StatusCode);
+
+        var fetched = await authenticated.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal("Original title", fetched!.Title);
+        Assert.Equal("Open", fetched.Status);
+    }
+
+    // C-009 — the health endpoint stays public.
+    [Fact]
+    public async Task Root_health_endpoint_stays_public()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/");
+        var body = await response.Content.ReadAsStringAsync();
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Contains("task-tracker", body);
+    }
+
+    // C-009 — the health endpoint is not disturbed by a bogus key either.
+    [Fact]
+    public async Task Root_health_endpoint_ignores_an_incorrect_key()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.SendAsync(Request(HttpMethod.Get, "/", WrongKey));
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    // C-003 — the key comparison is case-sensitive and exact.
+    [Fact]
+    public async Task Key_comparison_is_exact()
+    {
+        var client = _factory.CreateClient();
+
+        var casing = await client.SendAsync(Request(HttpMethod.Get, "/tasks", ValidKey.ToUpperInvariant()));
+        Assert.Equal(HttpStatusCode.Unauthorized, casing.StatusCode);
+
+        var whitespace = await client.SendAsync(Request(HttpMethod.Get, "/tasks", ValidKey + " "));
+        Assert.Equal(HttpStatusCode.Unauthorized, whitespace.StatusCode);
+
+        var empty = await client.SendAsync(Request(HttpMethod.Get, "/tasks", ""));
+        Assert.Equal(HttpStatusCode.Unauthorized, empty.StatusCode);
+    }
+
+    /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
+    private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
+}
