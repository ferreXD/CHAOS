+    // ---------------------------------------------------------------------------------------
+    // Optimistic concurrency control on PUT /tasks/{id}
+    // (change `optimistic-concurrency-updates`, contract statements C-001..C-010)
+    // ---------------------------------------------------------------------------------------
+
+    [Fact]
+    public async Task Post_returns_a_task_at_version_1()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Fresh task", status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(1, created!.Version);
+    }
+
+    [Fact]
+    public async Task Seeded_tasks_start_at_version_1()
+    {
+        var client = _factory.CreateClient();
+
+        var tasks = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+
+        var seeded = Assert.Single(
+            tasks!, t => t.Title == "Add query-param filters to GET /tasks");
+        Assert.Equal(1, seeded.Version);
+    }
+
+    [Fact]
+    public async Task Put_without_expected_version_succeeds_and_increments_the_version()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Unconditional update");
+        Assert.Equal(1, created.Version);
+
+        // No expectedVersion in the body at all — the backward-compatible path.
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Rewritten", status = "Done", priority = "High" });
+
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
+        var updated = await update.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(2, updated!.Version);
+        Assert.Equal("Rewritten", updated.Title);
+    }
+
+    [Fact]
+    public async Task Put_with_a_matching_expected_version_succeeds_and_increments_the_version()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Matching version");
+
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Updated", status = "InProgress", priority = "High", expectedVersion = 1 });
+
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
+        var updated = await update.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(2, updated!.Version);
+        Assert.Equal("Updated", updated.Title);
+    }
+
+    [Fact]
+    public async Task Put_with_a_stale_expected_version_is_rejected_with_409()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Stale writer");
+
+        // Move the task to version 2 so the caller's expectedVersion = 1 is stale.
+        await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Winner", status = "Done", priority = "High", expectedVersion = 1 });
+
+        var stale = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Loser", status = "Open", priority = "Low", expectedVersion = 1 });
+
+        Assert.Equal(HttpStatusCode.Conflict, stale.StatusCode);
+    }
+
+    [Fact]
+    public async Task A_rejected_update_leaves_the_task_completely_unchanged()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Untouched");
+
+        await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Winner", status = "Done", priority = "High", expectedVersion = 1 });
+
+        var before = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+
+        var stale = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Loser", status = "Open", priority = "Low", expectedVersion = 1 });
+        Assert.Equal(HttpStatusCode.Conflict, stale.StatusCode);
+
+        var after = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+
+        // Every field, including the version, is exactly as it was before the rejected update.
+        Assert.Equal(before, after);
+        Assert.Equal(2, after!.Version);
+        Assert.Equal("Winner", after.Title);
+    }
+
+    [Fact]
+    public async Task Successive_successful_updates_increment_the_version_monotonically()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Counting up");
+
+        var first = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Second", status = "Open", priority = "Low", expectedVersion = 1 });
+        var afterFirst = await first.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(2, afterFirst!.Version);
+
+        var second = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Third", status = "Open", priority = "Low", expectedVersion = 2 });
+        var afterSecond = await second.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(3, afterSecond!.Version);
+    }
+
+    [Fact]
+    public async Task Concurrent_updates_from_the_same_version_let_exactly_one_writer_win()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Contended");
+
+        // Ten writers all hold version 1. Optimistic concurrency must let exactly one through;
+        // an endpoint-side check-then-write would let several of these succeed.
+        var attempts = Enumerable.Range(0, 10).Select(i => client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = $"Writer {i}", status = "Done", priority = "High", expectedVersion = 1 }));
+
+        var responses = await Task.WhenAll(attempts);
+
+        Assert.Equal(1, responses.Count(r => r.StatusCode == HttpStatusCode.OK));
+        Assert.Equal(9, responses.Count(r => r.StatusCode == HttpStatusCode.Conflict));
+
+        var final = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal(2, final!.Version);
+    }
