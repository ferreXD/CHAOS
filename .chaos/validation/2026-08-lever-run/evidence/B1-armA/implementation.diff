+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Integration tests for the read-only aggregate endpoint <c>GET /tasks/count</c>.
+/// Lives in its own class so it gets its own <see cref="WebApplicationFactory{T}"/> — and
+/// therefore its own singleton store — which keeps the count invariants isolated from the
+/// CRUD baseline tests. xUnit runs tests within a class sequentially, so the before/after
+/// delta assertions are stable.
+/// </summary>
+public class TaskCountEndpointTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public TaskCountEndpointTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    /// <summary>Contract C-001.</summary>
+    [Fact]
+    public async Task Get_tasks_count_returns_200_with_an_integer_count()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/tasks/count");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        // Assert the wire shape directly rather than through a DTO: ReadFromJsonAsync uses
+        // web defaults (case-insensitive), so a DTO alone would also accept "Count". The
+        // contract names the field exactly "count", and it must be a JSON integer.
+        using var json = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
+        Assert.Equal(JsonValueKind.Object, json.RootElement.ValueKind);
+        Assert.True(json.RootElement.TryGetProperty("count", out var countProperty));
+        Assert.Equal(JsonValueKind.Number, countProperty.ValueKind);
+        Assert.True(countProperty.TryGetInt32(out var count));
+        Assert.True(count >= 0);
+    }
+
+    /// <summary>Contract C-002.</summary>
+    [Fact]
+    public async Task Count_equals_the_number_of_tasks_returned_by_get_tasks()
+    {
+        var client = _factory.CreateClient();
+
+        var tasks = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        var count = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        Assert.NotNull(tasks);
+        Assert.NotNull(count);
+        Assert.Equal(tasks!.Count, count!.Count);
+    }
+
+    /// <summary>Contract C-003.</summary>
+    [Fact]
+    public async Task Creating_a_task_increases_the_count_by_exactly_one()
+    {
+        var client = _factory.CreateClient();
+
+        var before = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        var created = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Counted task", status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+
+        var after = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        Assert.Equal(before!.Count + 1, after!.Count);
+    }
+
+    /// <summary>Contract C-004.</summary>
+    [Fact]
+    public async Task Deleting_a_task_decreases_the_count_by_exactly_one()
+    {
+        var client = _factory.CreateClient();
+
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Doomed task", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var before = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        var delete = await client.DeleteAsync($"/tasks/{created!.Id}");
+        Assert.Equal(HttpStatusCode.NoContent, delete.StatusCode);
+
+        var after = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        Assert.Equal(before!.Count - 1, after!.Count);
+    }
+
+    /// <summary>Contract C-005 — the root health endpoint is unchanged by this change.</summary>
+    [Fact]
+    public async Task Root_health_endpoint_is_unchanged()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var body = await response.Content.ReadFromJsonAsync<HealthDto>();
+        Assert.NotNull(body);
+        Assert.Equal("task-tracker", body!.Service);
+        Assert.Equal("ok", body.Status);
+    }
+
+    /// <summary>Mirror of the count endpoint's response shape.</summary>
+    private record CountDto(int Count);
+
+    /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
+    private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
+
+    /// <summary>Mirror of the root health endpoint's response shape.</summary>
+    private record HealthDto(string Service, string Status);
+}
