+        // GET /tasks[?priority=Low|Medium|High] — every task in the store, optionally narrowed
+        // to one priority. The filter is applied here rather than in TaskStore, which stays a
+        // plain container.
+        group.MapGet("/", (TaskStore store, string? priority) =>
+        {
+            IReadOnlyList<TaskItem> tasks = store.All();
+
+            if (priority is not null)
+            {
+                if (!TryParsePriority(priority, out var wanted))
+                {
+                    return Results.BadRequest(new
+                    {
+                        error = $"Unknown priority '{priority}'. Valid values: Low, Medium, High."
+                    });
+                }
+
+                tasks = tasks.Where(t => t.Priority == wanted).ToList();
+            }
+
+            return Results.Ok(tasks);
+        });
 
