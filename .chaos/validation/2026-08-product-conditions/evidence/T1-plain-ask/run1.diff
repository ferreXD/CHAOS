+    /// <summary>
+    /// Parses a <c>?priority=</c> value. Case-insensitive, matching how the same enum is read
+    /// from request bodies by JsonStringEnumConverter.
+    /// </summary>
+    /// <remarks>
+    /// Deliberately not <see cref="Enum.TryParse{TEnum}(string, bool, out TEnum)"/>: that also
+    /// accepts numeric text ("0", and even out-of-range "42"), which is not part of this API's
+    /// contract. Only the declared names are valid.
+    /// </remarks>
+    private static bool TryParsePriority(string value, out TaskPriority priority)
+    {
+        foreach (var candidate in Enum.GetValues<TaskPriority>())
+        {
+            if (string.Equals(candidate.ToString(), value, StringComparison.OrdinalIgnoreCase))
+            {
+                priority = candidate;
+                return true;
+            }
+        }
+
+        priority = default;
+        return false;
+    }
 }
