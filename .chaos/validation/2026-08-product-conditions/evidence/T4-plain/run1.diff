+    /// <summary>
+    /// Validates a submitted title, returning the 400 to send back or <c>null</c> if it is fine.
+    /// Shared by POST and PUT so the two verbs cannot drift apart on what a valid title is.
+    /// </summary>
+    /// <remarks>
+    /// The length is measured on the value as sent, not on a trimmed copy, because that is what
+    /// gets stored - trimming here would accept a title the API then returns at a different length.
+    /// </remarks>
+    private static IResult? ValidateTitle(string? title)
+    {
+        if (string.IsNullOrWhiteSpace(title))
+            return Results.BadRequest(new { error = "Title is required." });
+
+        if (title.Length > MaxTitleLength)
+        {
+            return Results.BadRequest(new
+            {
+                error = $"Title must be {MaxTitleLength} characters or fewer (got {title.Length})."
+            });
+        }
+
+        return null;
+    }
