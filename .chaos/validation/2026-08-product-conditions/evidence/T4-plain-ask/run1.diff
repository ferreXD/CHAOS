+    [Fact]
+    public async Task Post_with_a_title_at_the_length_limit_is_accepted()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var title = new string('a', 200);
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(title, created!.Title);
+    }
+
+    [Fact]
+    public async Task Post_with_an_overlong_title_is_rejected_and_creates_nothing()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var title = new string('b', 201);
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Contains("200 characters", await response.Content.ReadAsStringAsync());
+
+        var tasks = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        Assert.DoesNotContain(tasks!, t => t.Title.StartsWith("bbb"));
+    }
+
+    [Fact]
+    public async Task Put_with_a_title_at_the_length_limit_is_accepted()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Short", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+        var title = new string('c', 200);
+
+        var response = await client.PutAsJsonAsync(
+            $"/tasks/{created!.Id}", new { title, status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var fetched = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal(title, fetched!.Title);
+    }
+
+    /// <summary>
+    /// A rejected update must leave the stored task alone, not half-apply the other fields.
+    /// </summary>
+    [Fact]
+    public async Task Put_with_an_overlong_title_is_rejected_and_leaves_the_task_unchanged()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Keep me", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var response = await client.PutAsJsonAsync(
+            $"/tasks/{created!.Id}",
+            new { title = new string('d', 201), status = "Done", priority = "High" });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+        Assert.Contains("200 characters", await response.Content.ReadAsStringAsync());
+
+        var fetched = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal("Keep me", fetched!.Title);
+        Assert.Equal("Open", fetched.Status);
+    }
+
