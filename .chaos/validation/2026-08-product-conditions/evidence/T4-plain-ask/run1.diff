+    /// <summary>
+    /// Longest title the API accepts. A title of exactly this length is valid; the check is on
+    /// the string's length in characters, not on the encoded byte count - the body-size limit in
+    /// Program.cs is what bounds bytes.
+    /// </summary>
+    private const int MaxTitleLength = 200;
+
+    /// <summary>
+    /// The 400 for a title POST and PUT would both reject, or <c>null</c> if the title is usable.
+    /// Shared so the two verbs cannot drift into accepting different titles.
+    /// </summary>
+    private static IResult? ValidateTitle(string? title)
+    {
+        if (string.IsNullOrWhiteSpace(title))
+            return Results.BadRequest(new { error = "Title is required." });
+
+        if (title.Length > MaxTitleLength)
+        {
+            return Results.BadRequest(new
+            {
+                error = $"Title must be {MaxTitleLength} characters or fewer, but was {title.Length}."
+            });
+        }
+
+        return null;
+    }
+
