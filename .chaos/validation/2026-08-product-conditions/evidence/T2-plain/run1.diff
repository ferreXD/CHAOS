+    [Fact]
+    public async Task Post_with_a_due_date_stores_and_returns_it()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var due = new DateTimeOffset(2026, 9, 1, 17, 0, 0, TimeSpan.Zero);
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Ship the release", status = "Open", priority = "High", dueDate = due });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(due, created!.DueDate);
+
+        var fetched = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal(due, fetched!.DueDate);
+    }
+
+    [Fact]
+    public async Task Post_without_a_due_date_creates_a_task_that_has_none()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Someday", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        Assert.Null(created!.DueDate);
+
+        var fetched = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Null(fetched!.DueDate);
+    }
+
+    [Fact]
+    public async Task Post_with_an_explicitly_null_due_date_is_the_same_as_omitting_it()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks",
+            new { title = "No deadline", status = "Open", priority = "Low", dueDate = (DateTimeOffset?)null });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Null(created!.DueDate);
+    }
+
+    [Fact]
+    public async Task Put_can_set_a_due_date_on_a_task_that_had_none()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var due = new DateTimeOffset(2026, 10, 5, 12, 30, 0, TimeSpan.Zero);
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Plan the sprint", status = "Open", priority = "Medium" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Null(created!.DueDate);
+
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Plan the sprint", status = "InProgress", priority = "Medium", dueDate = due });
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
