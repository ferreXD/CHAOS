 /// <summary>An immutable task record held in the in-memory store.</summary>
+/// <remarks>
+/// <see cref="DueDate"/> is optional: <c>null</c> means the task has no due date, which is a
+/// normal state rather than missing data. It sits with the caller-supplied fields; the
+/// system-assigned <see cref="CreatedAt"/> stays last.
+/// </remarks>
 public record TaskItem(
     Guid Id,
     string Title,
     TaskState Status,
     TaskPriority Priority,
+    DateTimeOffset? DueDate,
     DateTimeOffset CreatedAt);
