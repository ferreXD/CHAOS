+        // GET /tasks — returns every task in the store, optionally filtered by priority.
+        group.MapGet("/", (string? priority, TaskStore store) =>
+        {
+            var tasks = store.All();
+
+            if (priority is not null)
+            {
+                if (!Enum.TryParse<TaskPriority>(priority, ignoreCase: true, out var parsedPriority))
+                    return Results.BadRequest(new { error = "Priority must be one of: Low, Medium, High." });
+
+                tasks = tasks.Where(t => t.Priority == parsedPriority).ToList();
+            }
+
+            return Results.Ok(tasks);
+        });
 
