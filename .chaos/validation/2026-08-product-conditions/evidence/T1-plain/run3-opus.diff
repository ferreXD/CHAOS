+        // GET /tasks[?priority=Low|Medium|High] — every task, optionally narrowed by priority.
+        // Filtering happens here rather than in TaskStore: the store stays a plain collection and
+        // the query-string contract lives with the route that defines it.
+        group.MapGet("/", (string? priority, TaskStore store) =>
+        {
+            // Absent parameter (and `?priority=` with no value) keeps the unfiltered behaviour.
+            if (string.IsNullOrEmpty(priority))
