+    /// <summary>
+    /// Parses a <c>?priority=</c> value by name, case-insensitively — the same leniency
+    /// <see cref="System.Text.Json.Serialization.JsonStringEnumConverter"/> already gives request
+    /// bodies, so "high" means the same thing in a query string as it does in a POST.
+    /// </summary>
+    /// <remarks>
+    /// Deliberately NOT <c>Enum.TryParse</c>: that also accepts the underlying numbers, so "0"
+    /// would silently mean Low and "7" would parse into a TaskPriority that matches nothing.
+    /// Matching against the declared names keeps the accepted set exactly Low/Medium/High.
+    /// </remarks>
+    private static bool TryParsePriority(string value, out TaskPriority priority)
+    {
+        foreach (var name in Enum.GetNames<TaskPriority>())
+        {
+            if (string.Equals(name, value, StringComparison.OrdinalIgnoreCase))
+            {
+                priority = Enum.Parse<TaskPriority>(name);
+                return true;
+            }
+        }
+
+        priority = default;
+        return false;
+    }
 }
