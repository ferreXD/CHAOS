@@ -7,7 +7,7 @@ namespace TaskTracker.Api.Endpoints;
 /// CRUD endpoints for tasks, mounted under <c>/tasks</c>.
 /// </summary>
 /// <remarks>
-/// GET /tasks currently returns EVERY task, unfiltered.
+/// GET /tasks returns every task unless narrowed by <c>?priority=</c>.
 /// </remarks>
 public static class TaskEndpoints
 {
@@ -19,8 +19,19 @@ public static class TaskEndpoints
             .RequireAuthorization()
             .RequireRateLimiting(Policies.TaskRateLimit);
 
-        // GET /tasks — returns every task in the store. No filtering (yet).
-        group.MapGet("/", (TaskStore store) => Results.Ok(store.All()));
+        // GET /tasks[?priority=Low|Medium|High] — the parameter is a plain string rather than a
+        // TaskPriority? so an unrecognised value produces our own 400 body, instead of the empty
+        // 400 minimal APIs emit when parameter binding fails.
+        group.MapGet("/", (string? priority, TaskStore store) =>
+        {
+            if (priority is null)
+                return Results.Ok(store.All());
+
+            if (!TryParsePriority(priority, out var wanted))
+                return Results.BadRequest(new { error = "Priority must be one of: Low, Medium, High." });
+
+            return Results.Ok(store.All().Where(task => task.Priority == wanted).ToList());
+        });
 
         // GET /tasks/{id}
         group.MapGet("/{id:guid}", (Guid id, TaskStore store) =>
@@ -53,4 +64,15 @@ public static class TaskEndpoints
 
         return app;
     }
+
+    private static bool TryParsePriority(string value, out TaskPriority priority)
+    {
+        priority = default;
+
+        var name = value.Trim();
+        if (name.Length == 0 || name.Contains(',') || !char.IsLetter(name[0]))
+            return false;
+
+        return Enum.TryParse(name, ignoreCase: true, out priority) && Enum.IsDefined(priority);
+    }
 }
