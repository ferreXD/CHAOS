+    [Fact]
+    public async Task Post_with_a_due_date_round_trips_it()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+        var due = new DateTimeOffset(2026, 9, 1, 17, 0, 0, TimeSpan.Zero);
