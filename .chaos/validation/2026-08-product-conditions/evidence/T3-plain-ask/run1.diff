diff --git a/src/TaskTracker.Api/Security/CallerIdentity.cs b/src/TaskTracker.Api/Security/CallerIdentity.cs
new file mode 100644
index 0000000..6ea642d
--- /dev/null
+++ b/src/TaskTracker.Api/Security/CallerIdentity.cs
@@ -0,0 +1,38 @@
+using System.IdentityModel.Tokens.Jwt;
+using System.Security.Claims;
+
+namespace TaskTracker.Api.Security;
+
+/// <summary>
+/// Resolves the task-owner identity of the authenticated caller.
+/// </summary>
+public static class CallerIdentity
+{
+    /// <summary>
+    /// Reads the caller's JWT <c>sub</c> claim, the value tasks are owned by.
+    /// </summary>
+    /// <remarks>
+    /// Read under <c>MapInboundClaims = false</c> (see Program.cs), so the claim still carries the
+    /// name the token spelled rather than the ClaimTypes.NameIdentifier URI the default inbound map
+    /// rewrites it to.
+    /// <para>
+    /// Returns <c>false</c> rather than falling back to a placeholder when the claim is absent or
+    /// blank: a validly signed token that names no subject authenticates a caller the API cannot
+    /// identify, and inventing an owner for it would put unrelated callers into one shared bucket.
+    /// Callers turn that into 401 - the credential is the problem, not the resource.
+    /// </para>
+    /// </remarks>
+    public static bool TryGetOwnerId(this ClaimsPrincipal user, out string ownerId)
+    {
+        var subject = user.FindFirstValue(JwtRegisteredClaimNames.Sub);
+
+        if (string.IsNullOrWhiteSpace(subject))
+        {
+            ownerId = string.Empty;
+            return false;
+        }
+
+        ownerId = subject;
+        return true;
+    }
+}
