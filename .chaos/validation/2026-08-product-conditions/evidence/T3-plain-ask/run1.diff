+using System.Net;
+using System.Net.Http.Json;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Covers task ownership: the owner is taken from the caller's JWT subject, listing returns only
+/// the caller's own tasks, and another owner's task is indistinguishable from one that does not
+/// exist.
+/// </summary>
+/// <remarks>
+/// The store is a process-lifetime singleton shared by every test in this class, so each test
+/// uses subjects unique to itself rather than a shared "alice"/"bob" pair - otherwise a task left
+/// behind by one test would show up in another's listing and the assertions would depend on
+/// execution order.
+/// </remarks>
+public class TaskOwnershipTests : IClassFixture<TestApiFactory>
+{
+    private readonly TestApiFactory _factory;
+
+    public TaskOwnershipTests(TestApiFactory factory) => _factory = factory;
+
+    [Fact]
+    public async Task Get_tasks_returns_only_the_callers_own_tasks()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-list-a");
+        var bob = _factory.CreateAuthenticatedClient("owner-list-b");
+
+        await Create(alice, "Alice's task");
+        await Create(bob, "Bob's task");
+
+        var alicesTasks = await alice.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks");
+        var bobsTasks = await bob.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks");
+
+        Assert.Contains(alicesTasks!, t => t.Title == "Alice's task");
+        Assert.DoesNotContain(alicesTasks!, t => t.Title == "Bob's task");
+
+        Assert.Contains(bobsTasks!, t => t.Title == "Bob's task");
+        Assert.DoesNotContain(bobsTasks!, t => t.Title == "Alice's task");
+    }
+
+    /// <summary>
+    /// The breaking half of the change stated as a test: before this, any authenticated caller got
+    /// every task in the store, seeds included.
+    /// </summary>
+    [Fact]
+    public async Task A_caller_who_has_created_nothing_sees_an_empty_list()
+    {
+        var newcomer = _factory.CreateAuthenticatedClient("owner-newcomer");
+
+        var tasks = await newcomer.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks");
+
+        Assert.Empty(tasks!);
+    }
+
+    [Fact]
+    public async Task The_priority_filter_does_not_widen_the_scope()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-filter-a");
+        var bob = _factory.CreateAuthenticatedClient("owner-filter-b");
+
+        await Create(alice, "Alice high", priority: "High");
+        await Create(bob, "Bob high", priority: "High");
+
+        var alicesHigh = await alice.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks?priority=High");
+
+        Assert.Contains(alicesHigh!, t => t.Title == "Alice high");
+        Assert.DoesNotContain(alicesHigh!, t => t.Title == "Bob high");
+    }
+
+    [Fact]
+    public async Task Reading_another_owners_task_by_id_is_404()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-read-a");
+        var bob = _factory.CreateAuthenticatedClient("owner-read-b");
+        var alices = await Create(alice, "Private to Alice");
+
+        var response = await bob.GetAsync($"/tasks/{alices.Id}");
+
+        // 404, not 403: a caller who cannot see the task must not learn that it exists.
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+        Assert.Equal(
+            HttpStatusCode.NotFound,
+            (await bob.GetAsync($"/tasks/{Guid.NewGuid()}")).StatusCode);
+    }
+
+    [Fact]
+    public async Task Updating_another_owners_task_is_404_and_changes_nothing()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-update-a");
+        var bob = _factory.CreateAuthenticatedClient("owner-update-b");
+        var alices = await Create(alice, "Alice's original");
+
+        var response = await bob.PutAsJsonAsync(
+            $"/tasks/{alices.Id}", new { title = "Hijacked", status = "Done", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+
+        var stillAlices = await alice.GetFromJsonAsync<TaskEndpointsTests.TaskDto>($"/tasks/{alices.Id}");
+        Assert.Equal("Alice's original", stillAlices!.Title);
+        Assert.Equal("Open", stillAlices.Status);
+    }
+
+    [Fact]
+    public async Task Deleting_another_owners_task_is_404_and_leaves_it_in_place()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-delete-a");
+        var bob = _factory.CreateAuthenticatedClient("owner-delete-b");
+        var alices = await Create(alice, "Alice's keeper");
+
+        var response = await bob.DeleteAsync($"/tasks/{alices.Id}");
+
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+
+        var survivor = await alice.GetAsync($"/tasks/{alices.Id}");
+        Assert.Equal(HttpStatusCode.OK, survivor.StatusCode);
+    }
+
+    [Fact]
+    public async Task An_owner_can_still_read_update_and_delete_their_own_task()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-happy-path");
+        var created = await Create(alice, "Mine");
+
+        Assert.Equal(HttpStatusCode.OK, (await alice.GetAsync($"/tasks/{created.Id}")).StatusCode);
+
+        var update = await alice.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Mine, edited", status = "Done", priority = "High" });
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
+
+        Assert.Equal(HttpStatusCode.NoContent, (await alice.DeleteAsync($"/tasks/{created.Id}")).StatusCode);
+        Assert.Equal(HttpStatusCode.NotFound, (await alice.GetAsync($"/tasks/{created.Id}")).StatusCode);
+    }
+
+    /// <summary>
+    /// A task created while authenticated as one subject is owned by that subject even if the same
+    /// HTTP client later presents a different token - ownership follows the credential on the
+    /// creating request, not the connection.
+    /// </summary>
+    [Fact]
+    public async Task Ownership_is_taken_from_the_token_on_the_creating_request()
+    {
+        var alice = _factory.CreateAuthenticatedClient("owner-source-a");
+        var bob = _factory.CreateAuthenticatedClient("owner-source-b");
+
+        var created = await Create(alice, "Created by Alice");
+
+        Assert.Equal(HttpStatusCode.NotFound, (await bob.GetAsync($"/tasks/{created.Id}")).StatusCode);
+        Assert.Equal(HttpStatusCode.OK, (await alice.GetAsync($"/tasks/{created.Id}")).StatusCode);
+    }
+
+    /// <summary>
+    /// The owner is the store's scoping key, not part of the wire contract; responses must not
+    /// start carrying it, since removing a published field later is itself a breaking change.
+    /// </summary>
+    [Fact]
+    public async Task The_owner_id_is_not_serialized_into_responses()
+    {
+        var client = _factory.CreateAuthenticatedClient("owner-not-serialized");
+        var created = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Check the wire shape", status = "Open", priority = "Low" });
+
+        var createdBody = await created.Content.ReadAsStringAsync();
+        var listBody = await (await client.GetAsync("/tasks")).Content.ReadAsStringAsync();
+
+        Assert.DoesNotContain("owner", createdBody, StringComparison.OrdinalIgnoreCase);
+        Assert.DoesNotContain("owner", listBody, StringComparison.OrdinalIgnoreCase);
+    }
+
+    public static TheoryData<string, string> TaskRoutes() => new()
+    {
+        { "GET", "/tasks" },
+        { "GET", "/tasks/11111111-1111-1111-1111-111111111111" },
+        { "POST", "/tasks" },
+        { "PUT", "/tasks/11111111-1111-1111-1111-111111111111" },
+        { "DELETE", "/tasks/11111111-1111-1111-1111-111111111111" },
+    };
+
+    /// <summary>
+    /// A correctly signed token that names no subject passes authentication but identifies nobody,
+    /// so there is no owner to scope to. Every route must refuse it rather than fall back to a
+    /// shared or empty owner - on all five, not just the one someone remembered to guard.
+    /// </summary>
+    [Theory]
+    [MemberData(nameof(TaskRoutes))]
+    public async Task A_valid_token_with_no_subject_claim_is_rejected(string method, string route)
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue(
+            "Bearer", TestApiFactory.MintToken(subject: null));
+
+        var request = new HttpRequestMessage(new HttpMethod(method), route);
+        if (method is "POST" or "PUT")
+        {
+            request.Content = JsonContent.Create(new { title = "Should never be created", status = "Open", priority = "Low" });
+        }
+
+        var response = await client.SendAsync(request);
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    private static async Task<TaskEndpointsTests.TaskDto> Create(
+        HttpClient client,
+        string title,
+        string priority = "Low")
+    {
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        return (await response.Content.ReadFromJsonAsync<TaskEndpointsTests.TaskDto>())!;
+    }
+}
