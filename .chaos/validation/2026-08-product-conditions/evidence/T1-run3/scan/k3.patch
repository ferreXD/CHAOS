-        // GET /tasks â€” returns every task in the store. No filtering (yet).
-        group.MapGet("/", (TaskStore store) => Results.Ok(store.All()));
+        // GET /tasks â€” every task in the store, optionally narrowed by ?priority=.
+        // The parameter is bound as a raw string rather than as TaskPriority? on purpose: the
+        // framework's enum binding delegates to Enum.TryParse, which also accepts numeric values
+        // ("0") and comma-separated lists ("Low,High"), so ?priority=Low,High would quietly
+        // return the Low tasks with a 200 instead of the 400 the contract requires.
+        group.MapGet("/", (string? priority, TaskStore store) =>
+        {
+            var tasks = store.All();
+
+            // Absent parameter = no filter. A present-but-empty ?priority= is a supplied value
+            // like any other, and so fails the check below rather than returning everything.
+            if (priority is null)
+                return Results.Ok(tasks);
+
+            if (!TryParsePriority(priority, out var requested))
+                return Results.BadRequest(new
+                {
+                    error = $"Unknown priority '{priority}'. Expected one of: Low, Medium, High."
+                });
+
+            return Results.Ok(tasks.Where(t => t.Priority == requested).ToList());
+        });
 
         // GET /tasks/{id}
         group.MapGet("/{id:guid}", (Guid id, TaskStore store) =>
@@ -55,4 +75,24 @@ public static class TaskEndpoints
 
         return app;
     }
+
+    /// <summary>
+    /// Matches a query value against the <see cref="TaskPriority"/> names, case-insensitively
+    /// (`low` and `Low` are the same value, as they already are in a request body) but exactly:
+    /// only a whole name matches, so lists, numeric values and the empty string are rejected.
+    /// </summary>
+    private static bool TryParsePriority(string value, out TaskPriority priority)
+    {
+        foreach (var name in Enum.GetNames<TaskPriority>())
+        {
+            if (string.Equals(name, value, StringComparison.OrdinalIgnoreCase))
+            {
+                priority = Enum.Parse<TaskPriority>(name);
+                return true;
+            }
+        }
+
+        priority = default;
+        return false;
+    }
 }
