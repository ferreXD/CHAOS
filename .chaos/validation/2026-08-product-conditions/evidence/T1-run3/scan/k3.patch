+    // ---- ?priority= filter (add-priority-filter) ----
+
+    [Fact]
+    public async Task Get_tasks_without_priority_returns_every_priority()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+
+        var all = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        var low = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?priority=Low");
+        var medium = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?priority=Medium");
+        var high = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?priority=High");
+
+        // The unfiltered list is exactly the three filtered lists put together: adding the
+        // filter did not start hiding anything from the default response.
+        Assert.Equal(all!.Count, low!.Count + medium!.Count + high!.Count);
+    }
+
+    [Fact]
+    public async Task Get_tasks_filtered_by_priority_returns_only_that_priority()
+    {
+        var client = _factory.CreateAuthenticatedClient();
+
+        var response = await client.GetAsync("/tasks?priority=High");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var tasks = await response.Content.ReadFromJsonAsync<List<TaskDto>>();
+        Assert.NotEmpty(tasks!);
+        Assert.All(tasks!, t => Assert.Equal("High", t.Priority));
+        Assert.Contains(tasks!, t => t.Title == "Add query-param filters to GET /tasks");
+    }
+
+    [Theory]
+    [InlineData("low")]
+    [InlineData("LOW")]
+    [InlineData("Low")]
+    public async Task Get_tasks_priority_filter_ignores_casing(string value)
+    {
+        var client = _factory.CreateAuthenticatedClient();
+
+        var canonical = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?priority=Low");
+        var variant = await client.GetFromJsonAsync<List<TaskDto>>($"/tasks?priority={value}");
+
+        Assert.Equal(
+            canonical!.Select(t => t.Id).OrderBy(id => id),
+            variant!.Select(t => t.Id).OrderBy(id => id));
+    }
+
+    [Fact]
+    public async Task Get_tasks_filter_matching_nothing_returns_an_empty_list()
+    {
+        // A dedicated app instance: the store is a singleton, so emptying a priority here
+        // must not disturb the seeded data the other tests in this class rely on.
+        using var factory = TestApiFactory.With(new Dictionary<string, string?>());
+        var client = factory.CreateAuthenticatedClient();
+
+        foreach (var task in await client.GetFromJsonAsync<List<TaskDto>>("/tasks?priority=Low") ?? [])
+        {
+            await client.DeleteAsync($"/tasks/{task.Id}");
+        }
+
+        var response = await client.GetAsync("/tasks?priority=Low");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        Assert.Empty((await response.Content.ReadFromJsonAsync<List<TaskDto>>())!);
+    }
+
+    [Theory]
+    [InlineData("Urgent")]      // not one of the three names
+    [InlineData("Low,High")]    // a list: Enum.TryParse would accept this and return the Low tasks
+    [InlineData("0")]           // a numeric enum value: Enum.TryParse would accept this too
+    [InlineData("2")]
+    [InlineData("")]            // present but empty - a supplied value, not an omitted parameter
+    [InlineData("  ")]
+    public async Task Get_tasks_with_an_unrecognised_priority_is_rejected(string value)
+    {
+        var client = _factory.CreateAuthenticatedClient();
+
+        var response = await client.GetAsync($"/tasks?priority={Uri.EscapeDataString(value)}");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
