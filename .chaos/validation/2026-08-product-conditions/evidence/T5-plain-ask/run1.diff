+        var task = await Create(client, "Back from the archive");
+        await Archive(client, task.Id);
+
+        var response = await client.PostAsync($"/tasks/{task.Id}/unarchive", null);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var restored = await response.Content.ReadFromJsonAsync<TaskEndpointsTests.TaskDto>();
+        Assert.Null(restored!.ArchivedAt);
+
+        var listed = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks");
+        Assert.Contains(listed!, t => t.Id == task.Id);
+    }
+
+    /// <summary>
+    /// A retried archive call must not move the timestamp: it records when the task was filed
+    /// away, not when someone last pressed the button.
+    /// </summary>
+    [Fact]
+    public async Task Archiving_an_already_archived_task_keeps_the_original_timestamp()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-idempotent");
+        var task = await Create(client, "Archive me twice");
+
+        var first = await Archive(client, task.Id);
+        var second = await Archive(client, task.Id);
+
+        Assert.NotNull(first.ArchivedAt);
+        Assert.Equal(first.ArchivedAt, second.ArchivedAt);
+    }
+
+    [Fact]
+    public async Task Unarchiving_a_task_that_is_not_archived_is_a_no_op()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-restore-noop");
+        var task = await Create(client, "Never archived");
+
+        var response = await client.PostAsync($"/tasks/{task.Id}/unarchive", null);
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+        var body = await response.Content.ReadFromJsonAsync<TaskEndpointsTests.TaskDto>();
+        Assert.Null(body!.ArchivedAt);
+        Assert.Equal("Never archived", body.Title);
+    }
+
+    /// <summary>
+    /// PUT replaces the task's content, not its archive state - otherwise any client still sending
+    /// bodies written before archiving existed would quietly refile every task it edited.
+    /// </summary>
+    [Fact]
+    public async Task Put_edits_an_archived_task_without_unarchiving_it()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-put");
+        var task = await Create(client, "Filed, then edited");
+        var archived = await Archive(client, task.Id);
+
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{task.Id}", new { title = "Edited while archived", status = "Done", priority = "High" });
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
+
+        var fetched = await client.GetFromJsonAsync<TaskEndpointsTests.TaskDto>($"/tasks/{task.Id}");
+        Assert.Equal("Edited while archived", fetched!.Title);
+        Assert.Equal(archived.ArchivedAt, fetched.ArchivedAt);
+        Assert.DoesNotContain(
+            (await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks"))!,
+            t => t.Id == task.Id);
+    }
+
+    [Fact]
+    public async Task Deleting_an_archived_task_still_works()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-then-delete");
+        var task = await Create(client, "Archived, then binned");
+        await Archive(client, task.Id);
+
+        Assert.Equal(HttpStatusCode.NoContent, (await client.DeleteAsync($"/tasks/{task.Id}")).StatusCode);
+        Assert.Equal(HttpStatusCode.NotFound, (await client.GetAsync($"/tasks/{task.Id}")).StatusCode);
+    }
+
