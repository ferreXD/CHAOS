@@ -0,0 +1,345 @@
+using System.Net;
+using System.Net.Http.Json;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Covers archiving: filing a task away so it leaves the working list without being destroyed,
+/// getting it back, and how <c>?archived=</c> decides which side of the archive a listing shows.
+/// </summary>
+/// <remarks>
+/// Like the ownership tests, these run against a process-lifetime store shared by the whole class,
+/// so each test uses a subject unique to itself. A test that asserts on a whole listing would
+/// otherwise depend on what its neighbours left behind.
+/// </remarks>
+public class TaskArchiveTests : IClassFixture<TestApiFactory>
+{
+    private readonly TestApiFactory _factory;
+
+    public TaskArchiveTests(TestApiFactory factory) => _factory = factory;
+
+    [Fact]
+    public async Task A_new_task_is_not_archived()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-fresh");
+
+        var created = await Create(client, "Brand new");
+
+        Assert.Null(created.ArchivedAt);
+    }
+
+    [Fact]
+    public async Task Archiving_takes_a_task_out_of_the_default_listing()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-hides");
+        var stale = await Create(client, "Old news");
+        var current = await Create(client, "Still relevant");
+
+        var response = await client.PostAsync($"/tasks/{stale.Id}/archive", null);
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var archived = await response.Content.ReadFromJsonAsync<TaskEndpointsTests.TaskDto>();
+        Assert.NotNull(archived!.ArchivedAt);
+
+        var listed = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks");
+        Assert.DoesNotContain(listed!, t => t.Id == stale.Id);
+        Assert.Contains(listed!, t => t.Id == current.Id);
+    }
+
+    /// <summary>
+    /// The whole point of archiving over deleting: the task is still there afterwards, content
+    /// intact, reachable by anyone holding its id.
+    /// </summary>
+    [Fact]
+    public async Task An_archived_task_is_still_readable_by_id_and_keeps_its_content()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-keeps");
+        var due = new DateTimeOffset(2026, 12, 1, 9, 0, 0, TimeSpan.Zero);
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Shipped last quarter", status = "Done", priority = "High", dueDate = due }))
+            .Content.ReadFromJsonAsync<TaskEndpointsTests.TaskDto>();
+
+        await Archive(client, created!.Id);
+
+        var fetched = await client.GetFromJsonAsync<TaskEndpointsTests.TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal("Shipped last quarter", fetched!.Title);
+        Assert.Equal("Done", fetched.Status);
+        Assert.Equal("High", fetched.Priority);
+        Assert.Equal(due, fetched.DueDate);
+        Assert.Equal(created.CreatedAt, fetched.CreatedAt);
+        Assert.NotNull(fetched.ArchivedAt);
+    }
+
+    [Fact]
+    public async Task Archived_true_lists_the_archive_and_nothing_else()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-only");
+        var filed = await Create(client, "Filed away");
+        var active = await Create(client, "On the list");
+        await Archive(client, filed.Id);
+
+        var listed = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks?archived=true");
+
+        Assert.Contains(listed!, t => t.Id == filed.Id);
+        Assert.DoesNotContain(listed!, t => t.Id == active.Id);
+        Assert.All(listed!, t => Assert.NotNull(t.ArchivedAt));
+    }
+
+    [Fact]
+    public async Task Archived_all_lists_both_sides()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-all");
+        var filed = await Create(client, "Filed away");
+        var active = await Create(client, "On the list");
+        await Archive(client, filed.Id);
+
+        var listed = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks?archived=all");
+
+        Assert.Contains(listed!, t => t.Id == filed.Id);
+        Assert.Contains(listed!, t => t.Id == active.Id);
+    }
+
+    /// <summary>Explicit <c>archived=false</c> asks for what an absent parameter already gives.</summary>
+    [Fact]
+    public async Task Archived_false_matches_the_default()
+    {
+        var client = _factory.CreateAuthenticatedClient("archive-false");
+        var filed = await Create(client, "Filed away");
+        await Create(client, "On the list");
+        await Archive(client, filed.Id);
+
+        var explicitly = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks?archived=false");
+        var byDefault = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>("/tasks");
+
+        Assert.Equal(
+            byDefault!.Select(t => t.Id).ToList(),
+            explicitly!.Select(t => t.Id).ToList());
+        Assert.DoesNotContain(explicitly!, t => t.Id == filed.Id);
+    }
+
+    [Theory]
+    [InlineData("TRUE")]
+    [InlineData("True")]
+    [InlineData("ALL")]
+    public async Task The_archived_filter_is_case_insensitive(string archived)
+    {
+        var client = _factory.CreateAuthenticatedClient($"archive-case-{archived}");
+        var filed = await Create(client, "Filed away");
+        await Archive(client, filed.Id);
+
+        var listed = await client.GetFromJsonAsync<List<TaskEndpointsTests.TaskDto>>($"/tasks?archived={archived}");
+
+        Assert.Contains(listed!, t => t.Id == filed.Id);
+    }
+
+    [Theory]
+    [InlineData("yes")]      // not one of the three accepted words
+    [InlineData("1")]        // numeric text is not part of the contract, as with ?priority=
+    [InlineData("archived")] // the field's name is not one of its values
+    [InlineData("")]         // present but empty is a supplied value, not an omitted one
