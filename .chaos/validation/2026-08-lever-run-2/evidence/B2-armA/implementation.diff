 /// CRUD endpoints for tasks, mounted under <c>/tasks</c>.
 /// </summary>
 /// <remarks>
-/// GET /tasks currently returns EVERY task, unfiltered. Closing that gap — adding optional
-/// <c>?status=</c> and <c>?priority=</c> filters — is the exercise the CHAOS worked example
-/// drives end-to-end. See <c>docs/demo/README.md</c>.
+/// GET /tasks supports an optional <c>?status=</c> filter (change: filter-tasks-by-status).
+/// The companion <c>?priority=</c> filter and AND-combination of the two are specified in
+/// <c>openspec/specs/task-api/spec.md</c> but are NOT implemented yet. See
+/// <c>docs/demo/README.md</c>.
 /// </remarks>
 public static class TaskEndpoints
 {
@@ -17,8 +18,23 @@ public static class TaskEndpoints
     {
         var group = app.MapGroup("/tasks");
 
-        // GET /tasks — returns every task in the store. No filtering (yet).
-        group.MapGet("/", (TaskStore store) => Results.Ok(store.All()));
+        // GET /tasks[?status=<state>] — every task, or only those in the requested state.
+        // Filtering lives here at the endpoint/query boundary, not in TaskStore's public
+        // shape (architecture: module/boundary model).
+        group.MapGet("/", (string? status, TaskStore store) =>
+        {
+            if (status is null)
+                return Results.Ok(store.All());
+
+            if (!TryParseTaskState(status, out var state))
+                return Results.BadRequest(new
+                {
+                    error = $"Unknown status value '{status}'. " +
+                            $"Valid values: {string.Join(", ", Enum.GetNames<TaskState>())}."
+                });
+
+            return Results.Ok(store.All().Where(t => t.Status == state).ToList());
+        });
 
         // GET /tasks/{id}
         group.MapGet("/{id:guid}", (Guid id, TaskStore store) =>
@@ -51,4 +67,26 @@ public static class TaskEndpoints
 
         return app;
     }
+
+    /// <summary>
+    /// Parses a query-param filter value into a <see cref="TaskState"/>, case-insensitively.
+    /// Only the declared enum <em>names</em> are accepted: numeric input (<c>?status=99</c>,
+    /// and equally <c>?status=0</c>) is rejected rather than silently cast to a state, so it
+    /// cannot bypass validation — the guard required by the accepted decision at
+    /// <c>docs/decision-log/2026-07-19-task-filter-validation.md</c>.
+    /// </summary>
+    private static bool TryParseTaskState(string value, out TaskState state)
+    {
+        var name = Enum.GetNames<TaskState>()
+            .FirstOrDefault(n => string.Equals(n, value, StringComparison.OrdinalIgnoreCase));
+
+        if (name is null)
+        {
+            state = default;
+            return false;
+        }
+
+        state = Enum.Parse<TaskState>(name);
+        return true;
+    }
 }
diff --git a/tests/TaskTracker.Tests/TaskEndpointsTests.cs b/tests/TaskTracker.Tests/TaskEndpointsTests.cs
index d2870e9..f8d9b3d 100644
--- a/tests/TaskTracker.Tests/TaskEndpointsTests.cs
+++ b/tests/TaskTracker.Tests/TaskEndpointsTests.cs
@@ -90,6 +90,90 @@ public class TaskEndpointsTests : IClassFixture<WebApplicationFactory<Program>>
         Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
     }
 
+    // --- status filtering on GET /tasks (change: filter-tasks-by-status) ---------------------
+    // NOTE: the WebApplicationFactory fixture is shared across this class, so the singleton
+    // store also holds tasks created by the sibling tests above. These tests therefore assert
+    // the contracted invariant — every returned task carries the requested status, and the
+    // known seeded task of that status is present — never an exact list length.
+
+    [Theory]
+    [InlineData("Open", "Add query-param filters to GET /tasks")]
+    [InlineData("InProgress", "Review the CHAOS proposal")]
+    [InlineData("Done", "Write the project README")]
+    public async Task Get_tasks_filtered_by_status_returns_only_that_status(
+        string status, string expectedSeededTitle)
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync($"/tasks?status={status}");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var tasks = await response.Content.ReadFromJsonAsync<List<TaskDto>>();
+
+        Assert.NotNull(tasks);
+        Assert.NotEmpty(tasks!);
+        Assert.All(tasks!, t => Assert.Equal(status, t.Status));
+        Assert.Contains(tasks!, t => t.Title == expectedSeededTitle);
+    }
+
+    [Fact]
+    public async Task Get_tasks_status_filter_is_case_insensitive()
+    {
+        var client = _factory.CreateClient();
+
+        var lower = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=open");
+        var proper = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=Open");
+
+        Assert.NotNull(lower);
+        Assert.NotNull(proper);
+        Assert.NotEmpty(lower!);
+        Assert.Equal(
+            proper!.Select(t => t.Id).OrderBy(id => id),
+            lower!.Select(t => t.Id).OrderBy(id => id));
+    }
+
+    [Fact]
+    public async Task Get_tasks_without_status_returns_every_status()
+    {
+        var client = _factory.CreateClient();
+
+        var all = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+
+        Assert.NotNull(all);
+        Assert.Contains(all!, t => t.Status == "Open");
+        Assert.Contains(all!, t => t.Status == "InProgress");
+        Assert.Contains(all!, t => t.Status == "Done");
+
+        // The unfiltered list is the union of the three filtered lists.
+        var filteredIds = new List<Guid>();
+        foreach (var status in new[] { "Open", "InProgress", "Done" })
+        {
+            var filtered = await client.GetFromJsonAsync<List<TaskDto>>($"/tasks?status={status}");
+            filteredIds.AddRange(filtered!.Select(t => t.Id));
+        }
+
+        Assert.Equal(
+            all!.Select(t => t.Id).OrderBy(id => id),
+            filteredIds.OrderBy(id => id));
+    }
+
+    [Theory]
+    [InlineData("Bogus")]
+    [InlineData("banana")]
+    [InlineData("99")]
+    public async Task Get_tasks_with_unrecognised_status_is_rejected(string status)
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync($"/tasks?status={status}");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+
+        // ... and returns no task list.
+        var body = await response.Content.ReadAsStringAsync();
+        Assert.False(body.TrimStart().StartsWith("["), $"expected no task list, got: {body}");
+    }
+
     /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
     private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
 }
