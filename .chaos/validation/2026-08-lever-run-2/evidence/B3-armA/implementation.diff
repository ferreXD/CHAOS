@@ -37,8 +43,8 @@ public static class TaskEndpoints
         // PUT /tasks/{id}
         group.MapPut("/{id:guid}", (Guid id, UpdateTaskRequest request, TaskStore store) =>
         {
-            if (string.IsNullOrWhiteSpace(request.Title))
