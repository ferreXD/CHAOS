+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Integration tests for the aggregate count endpoint (<c>GET /tasks/count</c>). Uses its own
+/// <see cref="WebApplicationFactory{T}"/> class fixture, so this class exercises its own store
+/// instance; xUnit runs the tests inside one class serially, which keeps the +1/-1 deltas exact.
+/// </summary>
+public class TaskCountEndpointTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public TaskCountEndpointTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    [Fact]
+    public async Task Get_count_returns_200_with_the_number_of_tasks()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/tasks/count");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var payload = await response.Content.ReadFromJsonAsync<CountDto>();
+        Assert.NotNull(payload);
+        Assert.True(payload!.Count > 0);
+    }
+
+    [Fact]
+    public async Task Count_equals_the_number_of_items_returned_by_get_tasks()
+    {
+        var client = _factory.CreateClient();
+
+        var tasks = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        var payload = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        Assert.NotNull(tasks);
+        Assert.NotNull(payload);
+        Assert.Equal(tasks!.Count, payload!.Count);
+    }
+
+    [Fact]
+    public async Task Creating_a_task_increases_count_by_exactly_one()
+    {
+        var client = _factory.CreateClient();
+
+        var before = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        var created = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Counted task", status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
+
+        var after = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+        Assert.Equal(before!.Count + 1, after!.Count);
+    }
+
+    [Fact]
+    public async Task Deleting_a_task_decreases_count_by_exactly_one()
+    {
+        var client = _factory.CreateClient();
+
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Doomed task", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var before = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+
+        var delete = await client.DeleteAsync($"/tasks/{created!.Id}");
+        Assert.Equal(HttpStatusCode.NoContent, delete.StatusCode);
+
+        var after = await client.GetFromJsonAsync<CountDto>("/tasks/count");
+        Assert.Equal(before!.Count - 1, after!.Count);
+    }
+
+    [Fact]
+    public async Task Root_health_endpoint_is_unchanged()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/");
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+
+        var health = await response.Content.ReadFromJsonAsync<HealthDto>();
+        Assert.Equal("task-tracker", health!.Service);
+        Assert.Equal("ok", health.Status);
+    }
+
+    /// <summary>Mirror of the count endpoint's response shape.</summary>
+    private record CountDto(int Count);
+
+    /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
+    private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
+
+    /// <summary>Mirror of the root health endpoint's response shape.</summary>
+    private record HealthDto(string Service, string Status);
+}
