@@ -0,0 +1,55 @@
+namespace TaskTracker.Api.Security;
+
+/// <summary>
+/// Endpoint filter that requires a valid API key on every route it is attached to.
+/// </summary>
+/// <remarks>
+/// Attached to the <c>/tasks</c> route group (see <c>Endpoints/TaskEndpoints.cs</c>), never to the
+/// application, so the public <c>GET /</c> health endpoint stays reachable without a key.
+/// <para>
+/// An endpoint filter runs after routing but <em>before</em> the endpoint delegate, which is what
+/// makes the rejection happen ahead of any existence or payload-validation check: an
+/// unauthenticated request for an unknown id gets 401 rather than 404, and an unauthenticated
+/// POST with a blank title gets 401 rather than 400. Nothing reaches the task store.
+/// </para>
+/// <para>
+/// Change of record: <c>require-api-key-auth</c>; posture crossing recorded in
+/// <c>.chaos/changes/require-api-key-auth/adr/2026-08-04-api-key-authentication.md</c>. This is a
+/// single shared demo credential — no identity, no rotation, no expiry.
+/// </para>
+/// </remarks>
+public sealed class ApiKeyEndpointFilter : IEndpointFilter
+{
+    /// <summary>The request header carrying the key.</summary>
+    public const string HeaderName = "X-Api-Key";
+
+    /// <summary>The configuration key holding the valid API key.</summary>
+    public const string ConfigurationKey = "ApiKey";
+
+    /// <summary>The key used when <see cref="ConfigurationKey"/> supplies no value.</summary>
+    public const string DefaultApiKey = "test-secret-key";
+
+    private readonly string _expectedKey;
+
+    public ApiKeyEndpointFilter(IConfiguration configuration)
+    {
+        var configured = configuration[ConfigurationKey];
+
+        // An unset OR blank configuration value falls back to the default. Treating a blank value
+        // as "the valid key" would let a caller authenticate with an empty header.
+        _expectedKey = string.IsNullOrEmpty(configured) ? DefaultApiKey : configured;
+    }
+
+    public ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        var presented = context.HttpContext.Request.Headers[HeaderName];
+
+        // Exactly one header value, matching ordinally (an API key is an opaque token). A missing
+        // header, a repeated header, or a mismatch is a bare 401 with no body — an anonymous
+        // caller learns nothing beyond "rejected".
+        if (presented.Count != 1 || !string.Equals(presented[0], _expectedKey, StringComparison.Ordinal))
+            return ValueTask.FromResult<object?>(Results.Unauthorized());
+
+        return next(context);
+    }
+}
diff --git a/tests/TaskTracker.Tests/ApiKeyAuthTests.cs b/tests/TaskTracker.Tests/ApiKeyAuthTests.cs
new file mode 100644
index 0000000..5ee5e56
