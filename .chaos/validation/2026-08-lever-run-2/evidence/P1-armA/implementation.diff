@@ -0,0 +1,213 @@
+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Integration tests for API-key authentication on the <c>/tasks</c> endpoints.
+/// Pins the contract of change <c>require-api-key-auth</c>: every task route demands a valid
+/// <c>X-Api-Key</c> header, the key comes from configuration key <c>ApiKey</c> (default
+/// <c>test-secret-key</c>), rejection is a bare 401 that happens before any existence or
+/// validation check, and <c>GET /</c> stays public.
+/// </summary>
+public class ApiKeyAuthTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private const string HeaderName = "X-Api-Key";
+    private const string DefaultKey = "test-secret-key";
+
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public ApiKeyAuthTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    /// <summary>A client that presents the given API key on every request.</summary>
+    private HttpClient KeyedClient(string key)
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Add(HeaderName, key);
+        return client;
+    }
+
+    /// <summary>A client that presents no API key at all.</summary>
+    private HttpClient AnonymousClient() => _factory.CreateClient();
+
+    private async Task<TaskDto> CreateTaskAsync(string title)
+    {
+        var response = await KeyedClient(DefaultKey).PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        return (await response.Content.ReadFromJsonAsync<TaskDto>())!;
+    }
+
+    // ---- C-001 / C-002: every task route rejects a missing key ------------------------------
+
+    [Fact]
+    public async Task Get_tasks_without_a_key_is_unauthorized()
+    {
+        var response = await AnonymousClient().GetAsync("/tasks");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Get_task_by_id_without_a_key_is_unauthorized()
+    {
+        var created = await CreateTaskAsync("Guarded by id");
+
+        var response = await AnonymousClient().GetAsync($"/tasks/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Post_task_without_a_key_is_unauthorized()
+    {
+        var response = await AnonymousClient().PostAsJsonAsync(
+            "/tasks", new { title = "Should never exist", status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Put_task_without_a_key_is_unauthorized()
+    {
+        var created = await CreateTaskAsync("Guarded against update");
+
+        var response = await AnonymousClient().PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Hijacked", status = "Done", priority = "High" });
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Delete_task_without_a_key_is_unauthorized()
+    {
+        var created = await CreateTaskAsync("Guarded against deletion");
+
+        var response = await AnonymousClient().DeleteAsync($"/tasks/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    // ---- C-003: a wrong key is rejected; C-001: the right key is accepted -------------------
+
+    [Fact]
+    public async Task An_incorrect_key_is_unauthorized()
+    {
+        var response = await KeyedClient("wrong-key").GetAsync("/tasks");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task An_empty_key_header_is_unauthorized()
+    {
+        var response = await KeyedClient(string.Empty).GetAsync("/tasks");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task The_valid_key_is_accepted_on_every_task_route()
+    {
+        var client = KeyedClient(DefaultKey);
+        var created = await CreateTaskAsync("Reachable with the key");
+
+        Assert.Equal(HttpStatusCode.OK, (await client.GetAsync("/tasks")).StatusCode);
+        Assert.Equal(HttpStatusCode.OK, (await client.GetAsync($"/tasks/{created.Id}")).StatusCode);
+        Assert.Equal(HttpStatusCode.OK, (await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Renamed", status = "Done", priority = "Low" })).StatusCode);
+        Assert.Equal(HttpStatusCode.NoContent, (await client.DeleteAsync($"/tasks/{created.Id}")).StatusCode);
+    }
+
+    // ---- C-004 / C-005: the key comes from configuration, with a default --------------------
+
+    [Fact]
+    public async Task The_default_key_applies_when_ApiKey_is_not_configured()
+    {
+        // The un-reconfigured factory has no ApiKey value; the documented default must apply.
+        var response = await KeyedClient(DefaultKey).GetAsync("/tasks");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task A_configured_ApiKey_replaces_the_default()
+    {
+        using var configured = _factory.WithWebHostBuilder(builder =>
+            builder.ConfigureAppConfiguration((_, config) =>
+                config.AddInMemoryCollection(new Dictionary<string, string?>
+                {
+                    ["ApiKey"] = "configured-key"
+                })));
+
+        var withConfiguredKey = configured.CreateClient();
+        withConfiguredKey.DefaultRequestHeaders.Add(HeaderName, "configured-key");
+        Assert.Equal(HttpStatusCode.OK, (await withConfiguredKey.GetAsync("/tasks")).StatusCode);
+
+        var withDefaultKey = configured.CreateClient();
+        withDefaultKey.DefaultRequestHeaders.Add(HeaderName, DefaultKey);
+        Assert.Equal(HttpStatusCode.Unauthorized, (await withDefaultKey.GetAsync("/tasks")).StatusCode);
+    }
+
+    // ---- C-006 / C-007: auth runs before existence and validation, and mutates nothing ------
+
+    [Fact]
+    public async Task An_unknown_id_without_a_key_is_401_not_404()
+    {
+        var response = await AnonymousClient().GetAsync($"/tasks/{Guid.NewGuid()}");
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task A_blank_title_post_without_a_key_is_401_not_400()
+    {
+        var response = await AnonymousClient().PostAsJsonAsync(
+            "/tasks", new { title = "", status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task An_unauthenticated_delete_leaves_the_task_in_place()
+    {
+        var created = await CreateTaskAsync("Survives an anonymous delete");
+
+        var delete = await AnonymousClient().DeleteAsync($"/tasks/{created.Id}");
+        Assert.Equal(HttpStatusCode.Unauthorized, delete.StatusCode);
+
+        var stillThere = await KeyedClient(DefaultKey).GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal("Survives an anonymous delete", stillThere!.Title);
+    }
+
+    [Fact]
+    public async Task An_unauthenticated_update_does_not_change_the_task()
+    {
+        var created = await CreateTaskAsync("Original title");
+
+        var update = await AnonymousClient().PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Overwritten", status = "Done", priority = "High" });
+        Assert.Equal(HttpStatusCode.Unauthorized, update.StatusCode);
+
+        var fetched = await KeyedClient(DefaultKey).GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal("Original title", fetched!.Title);
+        Assert.Equal("Open", fetched.Status);
+    }
+
+    // ---- C-008: the health endpoint stays public --------------------------------------------
+
+    [Fact]
+    public async Task The_root_health_endpoint_stays_public()
+    {
+        var response = await AnonymousClient().GetAsync("/");
+
+        Assert.Equal(HttpStatusCode.OK, response.StatusCode);
+    }
+
+    /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
+    private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
+}
