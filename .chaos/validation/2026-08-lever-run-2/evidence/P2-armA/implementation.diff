diff --git a/tests/TaskTracker.Tests/SoftDeleteTests.cs b/tests/TaskTracker.Tests/SoftDeleteTests.cs
new file mode 100644
index 0000000..246e9ae
--- /dev/null
+++ b/tests/TaskTracker.Tests/SoftDeleteTests.cs
@@ -0,0 +1,195 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Integration tests for soft-delete (change <c>soft-delete-tasks</c>). They boot the real API
+/// in-memory and assert the contract statements C-001..C-008, C-011 and C-012 over HTTP.
+/// </summary>
+/// <remarks>
+/// These tests deliberately never delete a SEEDED task, so the seeded-tasks assertion (C-008)
+/// stays independent of the order xUnit runs the class in.
+/// Field-shape assertions read the RAW JSON rather than a typed DTO: a typed mirror would
+/// deserialize a missing or misnamed field to null and let "null when active" pass spuriously.
+/// </remarks>
+public class SoftDeleteTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public SoftDeleteTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    // C-002 + C-003: DELETE soft-deletes (204) and the task is RETAINED, not removed.
+    [Fact]
+    public async Task Delete_soft_deletes_the_task_and_retains_it()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Soft delete me");
+
+        var delete = await client.DeleteAsync($"/tasks/{created.Id}");
+        Assert.Equal(HttpStatusCode.NoContent, delete.StatusCode);
+
+        // Retention is proved positively — not inferred from the task's absence elsewhere.
+        var all = await GetTasksAsync(client, includeDeleted: true);
+        var retained = Assert.Single(all, t => t.GetProperty("id").GetGuid() == created.Id);
+        Assert.Equal(JsonValueKind.String, retained.GetProperty("deletedAt").ValueKind);
+    }
+
+    // C-004: deleting an unknown id is still 404.
+    [Fact]
+    public async Task Delete_unknown_id_returns_404()
+    {
+        var client = _factory.CreateClient();
+
+        var delete = await client.DeleteAsync($"/tasks/{Guid.NewGuid()}");
+
+        Assert.Equal(HttpStatusCode.NotFound, delete.StatusCode);
+    }
+
+    // C-005: GET /tasks hides soft-deleted tasks by default.
+    [Fact]
+    public async Task Get_tasks_hides_soft_deleted_tasks_by_default()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Hidden after delete");
+
+        var before = await GetTasksAsync(client);
+        Assert.Contains(before, t => t.GetProperty("id").GetGuid() == created.Id);
+
+        await client.DeleteAsync($"/tasks/{created.Id}");
+
+        var after = await GetTasksAsync(client);
+        Assert.DoesNotContain(after, t => t.GetProperty("id").GetGuid() == created.Id);
+    }
+
+    // C-006: ?includeDeleted=true returns soft-deleted tasks, with a non-null deletedAt.
+    [Fact]
+    public async Task Get_tasks_with_include_deleted_returns_soft_deleted_tasks()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Visible with includeDeleted");
+        await client.DeleteAsync($"/tasks/{created.Id}");
+
+        var all = await GetTasksAsync(client, includeDeleted: true);
+
+        var found = Assert.Single(all, t => t.GetProperty("id").GetGuid() == created.Id);
+        var deletedAt = found.GetProperty("deletedAt");
+        Assert.Equal(JsonValueKind.String, deletedAt.ValueKind);
+        // C-001: an ISO-8601 timestamp, not an arbitrary string.
+        Assert.True(DateTimeOffset.TryParse(
+            deletedAt.GetString(),
+            System.Globalization.CultureInfo.InvariantCulture,
+            System.Globalization.DateTimeStyles.RoundtripKind,
+            out _));
+    }
+
+    // C-007: GET /tasks/{id} is 404 for a soft-deleted task.
+    [Fact]
+    public async Task Get_by_id_returns_404_for_a_soft_deleted_task()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Gone by id");
+        await client.DeleteAsync($"/tasks/{created.Id}");
+
+        var response = await client.GetAsync($"/tasks/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
+    }
+
+    // C-001: an active task serializes deletedAt as JSON null under that exact name.
+    [Fact]
+    public async Task Active_task_serializes_deleted_at_as_null()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Still active");
+
+        using var document = JsonDocument.Parse(
+            await client.GetStringAsync($"/tasks/{created.Id}"));
+
+        Assert.True(document.RootElement.TryGetProperty("deletedAt", out var deletedAt));
+        Assert.Equal(JsonValueKind.Null, deletedAt.ValueKind);
+    }
+
+    // C-008: the four seeded tasks are active after startup (backward-compatible migration).
+    [Fact]
+    public async Task Seeded_tasks_are_active_after_startup()
+    {
+        var client = _factory.CreateClient();
+        var seededTitles = new[]
+        {
+            "Write the project README",
+            "Add query-param filters to GET /tasks",
+            "Review the CHAOS proposal",
+            "Clean up sample data"
+        };
+
+        var tasks = await GetTasksAsync(client);
+
+        var seeded = tasks
+            .Where(t => seededTitles.Contains(t.GetProperty("title").GetString()))
+            .ToList();
+        Assert.Equal(4, seeded.Count);
+        Assert.All(seeded, t => Assert.Equal(JsonValueKind.Null, t.GetProperty("deletedAt").ValueKind));
+    }
+
+    // C-011: a repeat DELETE is 404 and does NOT overwrite the original deletion timestamp.
+    [Fact]
+    public async Task Repeat_delete_returns_404_and_keeps_the_original_timestamp()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "Delete me twice");
+
+        Assert.Equal(HttpStatusCode.NoContent,
+            (await client.DeleteAsync($"/tasks/{created.Id}")).StatusCode);
+        var firstStamp = await ReadDeletedAtAsync(client, created.Id);
+
+        var second = await client.DeleteAsync($"/tasks/{created.Id}");
+
+        Assert.Equal(HttpStatusCode.NotFound, second.StatusCode);
+        Assert.Equal(firstStamp, await ReadDeletedAtAsync(client, created.Id));
+    }
+
+    // C-012: PUT against a soft-deleted task is 404 — no resurrect-by-edit path.
+    [Fact]
+    public async Task Put_on_a_soft_deleted_task_returns_404()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateTaskAsync(client, "No edits after delete");
+        await client.DeleteAsync($"/tasks/{created.Id}");
+
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Resurrected", status = "Open", priority = "Low" });
+
+        Assert.Equal(HttpStatusCode.NotFound, update.StatusCode);
+    }
+
+    private static async Task<TaskDto> CreateTaskAsync(HttpClient client, string title)
+    {
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.NotNull(created);
+        return created!;
+    }
+
+    private static async Task<List<JsonElement>> GetTasksAsync(HttpClient client, bool includeDeleted = false)
+    {
+        var url = includeDeleted ? "/tasks?includeDeleted=true" : "/tasks";
+        using var document = JsonDocument.Parse(await client.GetStringAsync(url));
+        return document.RootElement.EnumerateArray().Select(e => e.Clone()).ToList();
+    }
+
+    private static async Task<string?> ReadDeletedAtAsync(HttpClient client, Guid id)
+    {
+        var all = await GetTasksAsync(client, includeDeleted: true);
+        return all.Single(t => t.GetProperty("id").GetGuid() == id)
+                  .GetProperty("deletedAt").GetString();
+    }
+
+    private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
+}
