diff --git a/tests/TaskTracker.Tests/TaskConcurrencyTests.cs b/tests/TaskTracker.Tests/TaskConcurrencyTests.cs
new file mode 100644
index 0000000..a985c40
--- /dev/null
+++ b/tests/TaskTracker.Tests/TaskConcurrencyTests.cs
@@ -0,0 +1,236 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Xunit;
+
+namespace TaskTracker.Tests;
+
+/// <summary>
+/// Integration tests for optimistic concurrency control on <c>PUT /tasks/{id}</c>
+/// (change <c>optimistic-concurrency-updates</c>). Each test class gets its own
+/// <see cref="WebApplicationFactory{T}"/>, hence its own singleton store, so these tests do not
+/// interfere with the pre-existing CRUD baseline in <see cref="TaskEndpointsTests"/>.
+/// </summary>
+public class TaskConcurrencyTests : IClassFixture<WebApplicationFactory<Program>>
+{
+    private readonly WebApplicationFactory<Program> _factory;
+
+    public TaskConcurrencyTests(WebApplicationFactory<Program> factory) => _factory = factory;
+
+    /// <summary>C-002 — POST /tasks returns a task at version 1.</summary>
+    [Fact]
+    public async Task Post_returns_a_task_at_version_1()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title = "Fresh task", status = "Open", priority = "High" });
+
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(1, created!.Version);
+    }
+
+    /// <summary>C-001 — the version integer is serialized under the JSON name "version".</summary>
+    [Fact]
+    public async Task Task_json_exposes_the_version_field_by_that_name()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Serialization subject");
+
+        using var document = JsonDocument.Parse(
+            await client.GetStringAsync($"/tasks/{created.Id}"));
+
+        Assert.True(
+            document.RootElement.TryGetProperty("version", out var version),
+            "the serialized task must carry a 'version' property");
+        Assert.Equal(JsonValueKind.Number, version.ValueKind);
+        Assert.Equal(1, version.GetInt32());
+    }
+
+    /// <summary>C-003 — tasks seeded at store construction start at version 1.</summary>
+    [Fact]
+    public async Task Seeded_tasks_start_at_version_1()
+    {
+        var client = _factory.CreateClient();
+
+        var tasks = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+
+        var seeded = tasks!.Where(t => t.Title == "Write the project README"
+                                    || t.Title == "Add query-param filters to GET /tasks"
+                                    || t.Title == "Review the CHAOS proposal"
+                                    || t.Title == "Clean up sample data")
+                           .ToList();
+
+        Assert.Equal(4, seeded.Count);
+        Assert.All(seeded, t => Assert.Equal(1, t.Version));
+    }
+
+    /// <summary>
+    /// C-009 — an update that omits expectedVersion proceeds unconditionally (last-writer-wins)
+    /// and still increments the version. This is the backward-compatible path.
+    /// </summary>
+    [Fact]
+    public async Task Put_without_expected_version_updates_unconditionally_and_increments()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Unconditional subject");
+
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Rewritten", status = "Done", priority = "Medium" });
+
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
+        var updated = await update.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal("Rewritten", updated!.Title);
+        Assert.Equal("Done", updated.Status);
+        Assert.Equal(2, updated.Version);
+    }
+
+    /// <summary>C-004 — successive successful updates keep incrementing: 1 -> 2 -> 3.</summary>
+    [Fact]
+    public async Task Successive_updates_keep_incrementing_the_version()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Ladder subject");
+        Assert.Equal(1, created.Version);
+
+        var first = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Step one", status = "InProgress", priority = "Low" });
+        Assert.Equal(HttpStatusCode.OK, first.StatusCode);
+        Assert.Equal(2, (await first.Content.ReadFromJsonAsync<TaskDto>())!.Version);
+
+        var second = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Step two", status = "Done", priority = "Low" });
+        Assert.Equal(HttpStatusCode.OK, second.StatusCode);
+        Assert.Equal(3, (await second.Content.ReadFromJsonAsync<TaskDto>())!.Version);
+
+        var fetched = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal(3, fetched!.Version);
+    }
+
+    /// <summary>C-008 — a matching expectedVersion succeeds with 200 and increments.</summary>
+    [Fact]
+    public async Task Put_with_matching_expected_version_succeeds_and_increments()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Matching subject");
+
+        var update = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Accepted", status = "Done", priority = "High", expectedVersion = 1 });
+
+        Assert.Equal(HttpStatusCode.OK, update.StatusCode);
+        var updated = await update.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal("Accepted", updated!.Title);
+        Assert.Equal(2, updated.Version);
+    }
+
+    /// <summary>C-006 — a stale expectedVersion is rejected with 409 Conflict.</summary>
+    [Fact]
+    public async Task Put_with_stale_expected_version_is_rejected_with_409()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Stale subject");
+
+        // Someone else's update moves the task from version 1 to version 2.
+        var winner = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Winner's edit", status = "InProgress", priority = "High", expectedVersion = 1 });
+        Assert.Equal(HttpStatusCode.OK, winner.StatusCode);
+
+        // Our client is still holding version 1 and tries to write over it.
+        var loser = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Loser's edit", status = "Done", priority = "Low", expectedVersion = 1 });
+
+        Assert.Equal(HttpStatusCode.Conflict, loser.StatusCode);
+
+        using var body = JsonDocument.Parse(await loser.Content.ReadAsStringAsync());
+        Assert.Equal(2, body.RootElement.GetProperty("actualVersion").GetInt32());
+    }
+
+    /// <summary>
+    /// C-007 — the rejected update leaves the task entirely unchanged: no field updated and no
+    /// version bump. This is the statement that makes the 409 meaningful.
+    /// </summary>
+    [Fact]
+    public async Task Rejected_update_leaves_the_task_completely_unchanged()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Untouched subject");
+
+        var winner = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Survivor", status = "InProgress", priority = "High", expectedVersion = 1 });
+        Assert.Equal(HttpStatusCode.OK, winner.StatusCode);
+        var survivor = await winner.Content.ReadFromJsonAsync<TaskDto>();
+
+        var rejected = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "Clobbered", status = "Done", priority = "Low", expectedVersion = 1 });
+        Assert.Equal(HttpStatusCode.Conflict, rejected.StatusCode);
+
+        var after = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal(survivor!.Title, after!.Title);
+        Assert.Equal(survivor.Status, after.Status);
+        Assert.Equal(survivor.Priority, after.Priority);
+        Assert.Equal(survivor.CreatedAt, after.CreatedAt);
+        Assert.Equal(2, after.Version);
+    }
+
+    /// <summary>C-010 — an unknown id still returns 404, whatever expectedVersion carries.</summary>
+    [Fact]
+    public async Task Put_for_an_unknown_id_returns_404_even_with_an_expected_version()
+    {
+        var client = _factory.CreateClient();
+
+        var withVersion = await client.PutAsJsonAsync(
+            $"/tasks/{Guid.NewGuid()}",
+            new { title = "Ghost", status = "Open", priority = "Low", expectedVersion = 1 });
+        Assert.Equal(HttpStatusCode.NotFound, withVersion.StatusCode);
+
+        var withoutVersion = await client.PutAsJsonAsync(
+            $"/tasks/{Guid.NewGuid()}",
+            new { title = "Ghost", status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.NotFound, withoutVersion.StatusCode);
+    }
+
+    /// <summary>C-011 — blank-title validation is unchanged and still precedes the version check.</summary>
+    [Fact]
+    public async Task Blank_title_is_still_rejected_with_400_even_with_a_matching_expected_version()
+    {
+        var client = _factory.CreateClient();
+        var created = await CreateAsync(client, "Validation subject");
+
+        var response = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}",
+            new { title = "", status = "Open", priority = "Low", expectedVersion = 1 });
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+
+        var after = await client.GetFromJsonAsync<TaskDto>($"/tasks/{created.Id}");
+        Assert.Equal("Validation subject", after!.Title);
+        Assert.Equal(1, after.Version);
+    }
+
+    private static async Task<TaskDto> CreateAsync(HttpClient client, string title)
+    {
+        var response = await client.PostAsJsonAsync(
+            "/tasks", new { title, status = "Open", priority = "Low" });
+        Assert.Equal(HttpStatusCode.Created, response.StatusCode);
+
+        var created = await response.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.NotNull(created);
+        return created!;
+    }
+
+    /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
+    private record TaskDto(
+        Guid Id,
+        string Title,
+        string Status,
+        string Priority,
+        DateTimeOffset CreatedAt,
+        int Version);
+}
