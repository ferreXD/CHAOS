 namespace TaskTracker.Api.Domain;
 
+/// <summary>How an attempted update against the store resolved.</summary>
+/// <remarks>
+/// Deliberately transport-agnostic: the store reports the outcome, the HTTP layer decides which
+/// status code it maps to (R-004 — the domain must not depend on the HTTP layer).
+/// </remarks>
+public enum TaskUpdateOutcome
+{
+    /// <summary>The task was updated and its <see cref="TaskItem.Version"/> incremented by 1.</summary>
+    Updated,
+
+    /// <summary>No task with that id exists.</summary>
+    NotFound,
+
+    /// <summary>
+    /// A caller-supplied expected version did not match the task's current version, so the task
+    /// was left entirely unchanged.
+    /// </summary>
+    VersionConflict
+}
+
+/// <summary>
+/// The result of <see cref="TaskStore.Update"/>. <see cref="Task"/> carries the updated task on
+/// <see cref="TaskUpdateOutcome.Updated"/>, the untouched current task on
+/// <see cref="TaskUpdateOutcome.VersionConflict"/>, and <c>null</c> on
+/// <see cref="TaskUpdateOutcome.NotFound"/>.
+/// </summary>
+public readonly record struct TaskUpdateResult(TaskUpdateOutcome Outcome, TaskItem? Task)
+{
+    public static TaskUpdateResult Updated(TaskItem task) => new(TaskUpdateOutcome.Updated, task);
+
+    public static TaskUpdateResult NotFound() => new(TaskUpdateOutcome.NotFound, null);
+
+    public static TaskUpdateResult VersionConflict(TaskItem current) =>
+        new(TaskUpdateOutcome.VersionConflict, current);
+}
+
