-    public bool Remove(Guid id) => _tasks.TryRemove(id, out _);
+    /// <summary>
+    /// Soft-deletes a task: stamps <see cref="TaskItem.DeletedAt"/> with the current time and
+    /// keeps the row in the store. Returns <c>false</c> when the id is unknown or the task is
+    /// already soft-deleted (both are "nothing to delete" — the endpoint maps that to 404).
+    /// </summary>
+    /// <remarks>
+    /// This replaces the former <c>Remove</c> hard delete. Visibility filtering deliberately
+    /// does NOT live here: <see cref="All"/> and <see cref="Get"/> keep returning every stored
+    /// row and the endpoint layer decides what a caller may see
+    /// (<c>docs/adr/ADR-001-soft-delete-store-shape.md</c>, PROP-DEC-001).
+    /// </remarks>
+    public bool SoftDelete(Guid id)
+    {
+        if (!_tasks.TryGetValue(id, out var existing) || existing.DeletedAt is not null)
+            return false;
+
+        _tasks[id] = existing with { DeletedAt = DateTimeOffset.UtcNow };
+        return true;
+    }
 
