+        var client = _factory.CreateClient();
+        var created = await (await client.PostAsJsonAsync(
+            "/tasks", new { title = "Still here", status = "Open", priority = "Low" }))
+            .Content.ReadFromJsonAsync<TaskDto>();
+
+        var json = await client.GetStringAsync($"/tasks/{created!.Id}");
+
+        using var doc = JsonDocument.Parse(json);
+        Assert.True(doc.RootElement.TryGetProperty("deletedAt", out var deletedAt));
+        Assert.Equal(JsonValueKind.Null, deletedAt.ValueKind);
