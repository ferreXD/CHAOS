+/// <summary>
+/// An immutable task record held in the in-memory store.
+/// </summary>
+/// <remarks>
+/// <c>DeletedAt</c> is the soft-delete marker: <c>null</c> while the task is active, and the
+/// time of deletion once <c>DELETE /tasks/{id}</c> has run. It is declared last with a
+/// <c>null</c> default so every pre-existing five-argument construction (including the seeded
+/// tasks) keeps compiling and keeps producing an active task — that default IS the
+/// backward-compatible migration for this in-memory store. See
+/// <c>docs/adr/ADR-001-soft-delete-store-shape.md</c>.
+/// </remarks>
 public record TaskItem(
     Guid Id,
     string Title,
     TaskState Status,
     TaskPriority Priority,
-    DateTimeOffset CreatedAt);
+    DateTimeOffset CreatedAt,
+    DateTimeOffset? DeletedAt = null);
