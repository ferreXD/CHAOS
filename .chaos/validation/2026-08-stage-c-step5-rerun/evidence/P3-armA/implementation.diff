-        var task = new TaskItem(Guid.NewGuid(), title, status, priority, createdAt);
+        var task = new TaskItem(Guid.NewGuid(), title, status, priority, createdAt, Version: 1);
         _tasks[task.Id] = task;
         return task;
     }
