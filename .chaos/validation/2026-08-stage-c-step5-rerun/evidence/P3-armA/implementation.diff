-            return store.Update(id, request.Title, request.Status, request.Priority) is { } updated
-                ? Results.Ok(updated)
-                : Results.NotFound();
+            // Optimistic concurrency: an omitted expectedVersion keeps the historical
+            // last-writer-wins behaviour; a stale one is rejected with 409 (PROP-DEC-001).
+            var result = store.Update(
+                id, request.Title, request.Status, request.Priority, request.ExpectedVersion);
