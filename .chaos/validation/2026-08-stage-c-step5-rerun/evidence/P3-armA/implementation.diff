+    /// not equal the stored version the task is left completely untouched and
+    /// <see cref="UpdateOutcome.VersionConflict"/> is returned; when it is null the update is
+    /// unconditional (last-writer-wins). Every successful update increments the version by 1.
+    /// </summary>
+    /// <remarks>
+    /// The compare-and-swap is atomic: the version check and the write happen in one
+    /// <see cref="ConcurrentDictionary{TKey,TValue}.TryUpdate"/>, and a lost race is retried
+    /// against the freshly observed state. A check-then-act in the endpoint would leave open
+    /// exactly the lost-update window this change closes (PROP-DEC-001, option B rejected).
+    /// </remarks>
+    public UpdateResult Update(
+        Guid id, string title, TaskState status, TaskPriority priority, int? expectedVersion = null)
     {
-        if (!_tasks.TryGetValue(id, out var existing))
-            return null;
+        while (true)
+        {
+            if (!_tasks.TryGetValue(id, out var existing))
+                return new UpdateResult(UpdateOutcome.NotFound, null);
+
+            if (expectedVersion is int expected && expected != existing.Version)
+                return new UpdateResult(UpdateOutcome.VersionConflict, existing);
+
+            var updated = existing with
+            {
+                Title = title,
+                Status = status,
+                Priority = priority,
+                Version = existing.Version + 1
+            };
+
+            if (_tasks.TryUpdate(id, updated, existing))
+                return new UpdateResult(UpdateOutcome.Updated, updated);
 
-        var updated = existing with { Title = title, Status = status, Priority = priority };
-        _tasks[id] = updated;
-        return updated;
+            // Another writer won the race; re-read and re-evaluate against the new state.
+        }
     }
 
     public bool Remove(Guid id) => _tasks.TryRemove(id, out _);
 
