+        var again = await client.PutAsJsonAsync(
+            $"/tasks/{created.Id}", new { title = "Twice", status = "Done", priority = "High" });
+        var afterSecond = await again.Content.ReadFromJsonAsync<TaskDto>();
+        Assert.Equal(3, afterSecond!.Version);
+        Assert.Equal("Twice", afterSecond.Title);
+    }
+
