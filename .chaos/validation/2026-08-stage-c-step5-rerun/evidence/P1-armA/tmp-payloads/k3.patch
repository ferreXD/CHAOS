--- /dev/null
+++ b/src/TaskTracker.Api/Security/ApiKeyEndpointFilter.cs
@@ -0,0 +1,55 @@
+using System.Security.Cryptography;
+using System.Text;
+
+namespace TaskTracker.Api.Security;
+
+/// <summary>
+/// Enforces the shared API key on the <c>/tasks</c> route group.
+/// </summary>
+/// <remarks>
+/// Applied as an endpoint filter on the group, so the check runs before the route handler —
+/// and therefore before any existence or payload-validation logic touches the store. The root
+/// health endpoint <c>GET /</c> is outside the group and stays public.
+/// See <c>docs/adr/ADR-001-api-key-authentication.md</c>.
+/// </remarks>
+public sealed class ApiKeyEndpointFilter : IEndpointFilter
+{
+    /// <summary>Request header that must carry the key.</summary>
+    public const string HeaderName = "X-Api-Key";
+
+    /// <summary>Configuration key holding the valid API key.</summary>
+    public const string ConfigurationKey = "ApiKey";
+
+    /// <summary>Development fallback used when <see cref="ConfigurationKey"/> is not configured.</summary>
+    public const string DefaultApiKey = "test-secret-key";
+
+    private readonly byte[] _expectedKey;
+
+    public ApiKeyEndpointFilter(IConfiguration configuration)
+    {
+        var configured = configuration[ConfigurationKey];
+        var key = string.IsNullOrEmpty(configured) ? DefaultApiKey : configured;
+        _expectedKey = Encoding.UTF8.GetBytes(key);
+    }
+
+    public ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
+    {
+        return IsAuthorized(context.HttpContext.Request)
+            ? next(context)
+            : ValueTask.FromResult<object?>(Results.Unauthorized());
+    }
+
+    private bool IsAuthorized(HttpRequest request)
+    {
+        if (!request.Headers.TryGetValue(HeaderName, out var values))
+            return false;
+
+        var presented = values.ToString();
+        if (string.IsNullOrEmpty(presented))
+            return false;
+
+        // Fixed-time comparison so a wrong key cannot be probed byte by byte.
+        return CryptographicOperations.FixedTimeEquals(
+            Encoding.UTF8.GetBytes(presented), _expectedKey);
+    }
+}
