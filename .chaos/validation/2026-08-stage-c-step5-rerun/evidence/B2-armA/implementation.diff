-        // GET /tasks — returns every task in the store. No filtering (yet).
-        group.MapGet("/", (TaskStore store) => Results.Ok(store.All()));
+        // GET /tasks[?status=Open|InProgress|Done] — all tasks, or only those in one state.
+        // The match is case-insensitive; an unrecognised value is a 400, never a silent full list.
+        group.MapGet("/", (string? status, TaskStore store) =>
+        {
+            IReadOnlyList<TaskItem> tasks = store.All();
+
+            if (!string.IsNullOrWhiteSpace(status))
+            {
+                if (!TryParseState(status, out var state))
+                    return Results.BadRequest(new
+                    {
+                        error = $"Unknown status '{status}'. Expected one of: {string.Join(", ", Enum.GetNames<TaskState>())}."
+                    });
+
+                tasks = tasks.Where(t => t.Status == state).ToList();
+            }
+
+            return Results.Ok(tasks);
+        });
 
         // GET /tasks/{id}
         group.MapGet("/{id:guid}", (Guid id, TaskStore store) =>
@@ -51,4 +69,24 @@ public static class TaskEndpoints
 
         return app;
     }
+
+    /// <summary>
+    /// Case-insensitive lookup of a <see cref="TaskState"/> by name. Deliberately name-based
+    /// (not <c>Enum.TryParse</c>) so numeric input such as <c>?status=1</c> is rejected too:
+    /// the contract accepts the state NAMES only.
+    /// </summary>
+    private static bool TryParseState(string value, out TaskState state)
+    {
+        foreach (var candidate in Enum.GetValues<TaskState>())
+        {
+            if (string.Equals(candidate.ToString(), value, StringComparison.OrdinalIgnoreCase))
+            {
+                state = candidate;
+                return true;
+            }
+        }
+
+        state = default;
+        return false;
+    }
 }
diff --git a/tests/TaskTracker.Tests/TaskEndpointsTests.cs b/tests/TaskTracker.Tests/TaskEndpointsTests.cs
