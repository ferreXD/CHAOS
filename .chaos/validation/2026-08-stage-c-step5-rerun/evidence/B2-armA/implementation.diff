--- a/tests/TaskTracker.Tests/TaskEndpointsTests.cs
+++ b/tests/TaskTracker.Tests/TaskEndpointsTests.cs
@@ -90,6 +90,71 @@ public class TaskEndpointsTests : IClassFixture<WebApplicationFactory<Program>>
         Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
     }
 
+    [Fact]
+    public async Task Get_tasks_filtered_by_status_returns_only_that_status()
+    {
+        var client = _factory.CreateClient();
+
+        foreach (var state in new[] { "Open", "InProgress", "Done" })
+        {
+            var filtered = await client.GetFromJsonAsync<List<TaskDto>>($"/tasks?status={state}");
+
+            Assert.NotNull(filtered);
+            Assert.NotEmpty(filtered!);
+            Assert.All(filtered!, t => Assert.Equal(state, t.Status));
+        }
+
+        // The seeded InProgress task is the only seeded one in that state.
+        var inProgress = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=InProgress");
+        Assert.Contains(inProgress!, t => t.Title == "Review the CHAOS proposal");
+        Assert.DoesNotContain(inProgress!, t => t.Title == "Add query-param filters to GET /tasks");
+    }
+
+    [Fact]
+    public async Task Status_filter_is_case_insensitive()
+    {
+        var client = _factory.CreateClient();
+
+        var lower = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=open");
+        var canonical = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=Open");
+
+        Assert.NotNull(lower);
+        Assert.NotEmpty(lower!);
+        Assert.Equal(
+            canonical!.Select(t => t.Id).OrderBy(id => id),
+            lower!.Select(t => t.Id).OrderBy(id => id));
+    }
+
+    [Fact]
+    public async Task Get_tasks_with_an_unknown_status_is_rejected()
+    {
+        var client = _factory.CreateClient();
+
+        var response = await client.GetAsync("/tasks?status=Bogus");
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+
+        // 400 means no task list came back at all.
+        var body = await response.Content.ReadAsStringAsync();
+        Assert.DoesNotContain("\"title\"", body, StringComparison.OrdinalIgnoreCase);
+    }
+
+    [Fact]
+    public async Task Get_tasks_without_a_status_still_returns_every_task()
+    {
+        var client = _factory.CreateClient();
+
+        var all = await client.GetFromJsonAsync<List<TaskDto>>("/tasks");
+        var open = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=Open");
+        var inProgress = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=InProgress");
+        var done = await client.GetFromJsonAsync<List<TaskDto>>("/tasks?status=Done");
+
+        Assert.NotNull(all);
+        Assert.Equal(all!.Count, open!.Count + inProgress!.Count + done!.Count);
+        Assert.Contains(all!, t => t.Title == "Write the project README");
+        Assert.Contains(all!, t => t.Title == "Clean up sample data");
+    }
+
     /// <summary>Mirror of the API's task shape; enums arrive as strings ("Open", "High").</summary>
     private record TaskDto(Guid Id, string Title, string Status, string Priority, DateTimeOffset CreatedAt);
