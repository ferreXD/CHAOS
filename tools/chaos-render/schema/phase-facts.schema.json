            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "rollup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "driftLoad",
            "decisionLoad",
