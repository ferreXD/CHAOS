          "properties": {
            "driftLoad": {
              "$ref": "#/$defs/impactLoad"
            },
            "decisionLoad": {
              "$ref": "#/$defs/impactLoad"
            },
            "ruleImpact": {
              "$ref": "#/$defs/impactLoad"
            },
            "gateImpact": {
              "$ref": "#/$defs/impactLoad"
            },
            "adrImpact": {
              "$ref": "#/$defs/impactLoad"
            },
            "manualFollowUpRequired": {
              "type": "boolean"
            }
          }
        }
      }
