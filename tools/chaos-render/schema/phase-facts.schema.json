                "contributor-safe",
                "maintainer",
                "repo-owner"
              ]
            },
            "dryRun": {
              "type": "boolean"
            }
          }
        },
        "sourceManifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "status"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "drift",
                  "empty",
                  "missing"
                ]
              },
              "finding": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^SYNC-\\d{3}$"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "openspec": {
          "$ref": "#/$defs/openspecCheck"
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contextSource",
            "confidence"
