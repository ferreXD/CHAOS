            "properties": {
              "action": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notModified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ruleCandidates": {
          "type": "array",
          "items": {
            "type": "object",
