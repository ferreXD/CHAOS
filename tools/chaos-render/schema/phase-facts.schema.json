              "severity": {
                "type": "string",
                "enum": [
                  "advisory",
                  "minor",
                  "major",
                  "blocker"
                ]
              }
            }
          }
        },
        "gateCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "#/$defs/decisionRef"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "reason",
              "impact",
              "followUp"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "followUp": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "consistencyChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "result"
