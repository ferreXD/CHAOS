                    "token": {
                      "type": "string",
                      "enum": [
                        "NO_PROMOTION",
                        "OPENSPEC_UPDATE",
                        "ADR_CANDIDATE",
                        "ADR_REQUIRED",
                        "RULE_UPDATE",
                        "ACCEPTED_RISK",
                        "FOLLOW_UP_CHANGE",
                        "CONTEXT_RECONCILIATION"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "done",
                        "satisfied",
                        "candidate",
                        "pending",
                        "blocked",
                        "closed"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "appliedActions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "file",
              "result"
