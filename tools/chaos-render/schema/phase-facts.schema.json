            "confidence": {
              "$ref": "#/$defs/confidence"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "driftFindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "category",
              "severity",
              "knowledge",
              "confidence",
              "summary",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SYNC-\\d{3}$"
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "knowledge": {
                "$ref": "#/$defs/knowledge"
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "APPLY",
                      "RECOMMEND",
                      "DEFER"
                    ]
                  },
                  "target": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "decisionReconciliation": {
          "type": "array",
