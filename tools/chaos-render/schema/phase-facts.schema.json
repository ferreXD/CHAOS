    "archiveFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "closureMatrix",
        "openspecArchive",
        "sourceOfTruth"
      ],
      "properties": {
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "verificationRun",
            "forceWaiver",
            "governanceOverride"
          ],
          "properties": {
            "decision": {
              "$ref": "#/$defs/decisionRef"
            },
            "verificationRun": {
              "$ref": "#/$defs/runId"
            },
            "forceWaiver": {
              "type": "boolean"
            },
            "governanceOverride": {
              "type": "boolean"
            }
          }
        },
        "preArchiveValidation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkRow"
          }
        },
        "closureMatrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "source",
              "classification",
              "closure",
              "syncAction",
              "confidence"
            ],
            "properties": {
              "decision": {
                "$ref": "#/$defs/decisionRef"
              },
              "source": {
                "type": "string",
                "enum": [
                  "propose",
                  "review",
                  "apply",
                  "verify",
                  "sync",
                  "archive",
                  "code-review",
                  "retro"
                ]
              },
              "classification": {
                "type": "string",
                "minLength": 1
              },
              "closure": {
                "type": "string",
                "enum": [
                  "CLOSED",
                  "ACCEPTED_RISK",
                  "FOLLOW_UP_CHANGE_REQUIRED",
                  "OPENSPEC_AMENDED"
                ]
              },
              "syncAction": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tokens"
                ],
                "properties": {
                  "tokens": {
                    "$ref": "#/$defs/syncActionTokens"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "retroTopic": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "$ref": "#/$defs/confidence"
              }
            }
          }
        },
        "openspecArchive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "archivedAs",
            "totals"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "archivedAs": {
              "type": "string",
              "minLength": 1
            },
            "totals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "added",
                "modified",
                "removed",
                "renamed"
              ],
              "properties": {
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "modified": {
                  "type": "integer",
                  "minimum": 0
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0
                },
                "renamed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "promotions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "capability",
                  "op",
                  "requirements"
                ],
                "properties": {
                  "capability": {
                    "type": "string",
                    "minLength": 1
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "create",
                      "modify",
                      "remove"
                    ]
                  },
                  "requirements": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sourceOfTruth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "checks"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "PARTIAL",
                "UNCONFIRMED"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/checkRow"
              }
            }
          }
        },
        "acceptedRisks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "condition",
              "acceptedBy",
              "date",
              "rationale",
              "impact"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/decisionRef"
              },
              "risk": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/riskId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "acceptedBy": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "confidenceImpact": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "followUp": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "reason",
              "impact",
              "route"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "debtLoad": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    }
  }
}
