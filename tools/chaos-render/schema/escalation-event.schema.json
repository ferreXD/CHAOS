{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaos.local/schema/chaos-render/1/escalation-event.schema.json",
  "title": "CHAOS Escalation Event (canonical parse)",
  "description": "The canonical parsed shape of an ESC-<nnn> ledger entry in decision-events.md (same '- key: value' grammar as decision entries). Auto-escalations are recorded as ESC events; a HUMAN-decided mode change is instead a decision entry carrying the 'escalates' field. The renderer derives the H1 escalation-warning chain and frontmatter escalatedFrom from the ordered union of both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "from", "to", "trigger", "keptWork"],
  "properties": {
    "id": { "type": "string", "pattern": "^ESC-\\d{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "date"],
      "properties": {
        "state": { "type": "string", "const": "RECORDED" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "from": { "type": "string", "enum": ["light", "standard", "strict"] },
    "to": { "type": "string", "enum": ["light", "standard", "strict"] },
    "trigger": {
      "type": "string",
      "enum": [
        "posture-crossing",
        "decision-count",
        "scope-spill",
        "self-review-fail",
        "openspec-degraded",
        "answer-widened-scope"
      ]
    },
    "keptWork": { "type": "string", "minLength": 1 },
    "evidence": { "type": ["string", "null"] },
    "knowledge": { "type": ["string", "null"], "enum": ["FACT", "INFERENCE", "ASSUMPTION", "UNKNOWN", null] },
    "confidence": { "type": ["string", "null"], "enum": ["HIGH", "MEDIUM", "LOW", null] },
    "extras": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
