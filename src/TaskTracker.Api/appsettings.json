{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Auth:SigningKey is deliberately ABSENT. It is secret material and must come from outside
  // the repository (user-secrets, environment variable, or the platform's secret store).
  // The app fails to start without it - see AuthOptions.Validate in Program.cs.
  "Auth": {
    "Issuer": "task-tracker",
    "Audience": "task-tracker-clients",
    "TokenLifetimeMinutes": 60,
    "EnableDevTokenEndpoint": false
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "LivenessPermitLimit": 300
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Limits": {
    "MaxRequestBodyBytes": 32768
  }
}
